---
import BaseLayout from "../layouts/BaseLayout.astro";
import { apiFetch } from "../lib/api.ts";

const { accessToken } = Astro.locals;

let spaces: { slug: string; name: string; description: string | null; visibility: string; personal: boolean }[] = [];
try {
  const res = await apiFetch("/api/spaces", accessToken);
  spaces = await res.json();
} catch {
  // API not available
}
---

<BaseLayout title="Spaces">
  <div class="home">
    <div class="home-hero">
      <h1 class="home-title">Documentation</h1>
      <p class="home-subtitle">Browse spaces or search for what you need</p>
    </div>

    {accessToken && (
      <div id="create-space-area">
        <button class="create-space-btn" id="create-space-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          New space
        </button>
        <form class="create-space-form" id="create-space-form" style="display:none">
          <input type="text" name="name" placeholder="Space name" class="create-input" required />
          <input type="text" name="slug" placeholder="slug (auto)" class="create-input create-input-slug" />
          <select name="visibility" class="create-select">
            <option value="private">Private</option>
            <option value="public">Public</option>
            <option value="org">Org</option>
            <option value="shared">Shared link</option>
          </select>
          <button type="submit" class="create-submit">Create</button>
          <button type="button" class="create-cancel" id="create-cancel">Cancel</button>
        </form>
      </div>
    )}

    <div class="space-grid">
      {spaces.length === 0 && !accessToken && (
        <p class="empty-state">No spaces yet.</p>
      )}
      {spaces.length === 0 && accessToken && (
        <p class="empty-state">No spaces yet. Create one above.</p>
      )}
      {spaces.map((space, i) => (
        <a
          href={`/s/${space.slug}`}
          class="space-card animate-in"
          style={`animation-delay: ${i * 60}ms`}
        >
          <div class="space-card-icon">
            {space.personal ? (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
              </svg>
            ) : (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
              </svg>
            )}
          </div>
          <div class="space-card-content">
            <h2 class="space-card-name">{space.name}</h2>
            {space.description && (
              <p class="space-card-desc">{space.description}</p>
            )}
          </div>
          <div class="space-card-meta">
            <span class:list={["visibility-badge", space.visibility]}>
              {space.visibility}
            </span>
          </div>
        </a>
      ))}
    </div>

    <div class="setup-link">
      <a href="/setup">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="4 17 10 11 4 5" /><line x1="12" y1="19" x2="20" y2="19" />
        </svg>
        CLI, MCP & API setup
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </a>
    </div>
  </div>
</BaseLayout>


<style>
  .home {
    max-width: 800px;
    margin: 0 auto;
    padding: 1rem 0;
  }

  .home-hero {
    padding: 2rem 0 3rem;
  }

  .home-title {
    font-family: var(--sw-font-display);
    font-size: var(--sw-text-4xl);
    font-weight: 400;
    letter-spacing: -0.03em;
    color: var(--sw-text-primary);
    margin-bottom: 0.5rem;
  }

  .home-subtitle {
    font-size: var(--sw-text-lg);
    color: var(--sw-text-tertiary);
  }

  .space-grid {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--sw-border);
    border: 1px solid var(--sw-border);
    border-radius: var(--sw-radius-lg);
    overflow: hidden;
  }

  .space-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: var(--sw-ink);
    text-decoration: none;
    color: inherit;
    transition: background var(--sw-duration) var(--sw-ease);
  }

  .space-card:hover {
    background: var(--sw-ink-light);
  }

  .space-card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--sw-ink-lighter);
    border-radius: var(--sw-radius-md);
    color: var(--sw-accent);
    flex-shrink: 0;
  }

  .space-card-content {
    flex: 1;
    min-width: 0;
  }

  .space-card-name {
    font-family: var(--sw-font-display);
    font-size: var(--sw-text-lg);
    font-weight: 500;
    color: var(--sw-text-primary);
    margin-bottom: 0.15rem;
  }

  .space-card-desc {
    font-size: var(--sw-text-sm);
    color: var(--sw-text-tertiary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .space-card-meta {
    flex-shrink: 0;
  }

  .visibility-badge {
    font-size: var(--sw-text-xs);
    padding: 0.2em 0.6em;
    border-radius: 4px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .visibility-badge.public {
    background: rgba(74, 222, 128, 0.1);
    color: var(--sw-success);
  }

  .visibility-badge.private {
    background: rgba(248, 113, 113, 0.1);
    color: var(--sw-error);
  }

  .visibility-badge.org {
    background: rgba(96, 165, 250, 0.1);
    color: var(--sw-info);
  }

  .visibility-badge.shared {
    background: rgba(251, 191, 36, 0.1);
    color: var(--sw-warning);
  }

  .empty-state {
    padding: 3rem;
    text-align: center;
    background: var(--sw-ink);
    color: var(--sw-text-ghost);
  }

  .setup-link {
    margin-top: 2.5rem;
    text-align: center;
  }

  .setup-link a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--sw-text-tertiary);
    text-decoration: none;
    font-size: var(--sw-text-sm);
    transition: color var(--sw-duration-fast) var(--sw-ease);
  }

  .setup-link a:hover {
    color: var(--sw-accent);
  }

  #create-space-area {
    margin-bottom: 1.5rem;
  }

  .create-space-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: none;
    border: 1px dashed var(--sw-border-strong);
    border-radius: var(--sw-radius-md);
    color: var(--sw-text-secondary);
    font-size: var(--sw-text-sm);
    cursor: pointer;
    transition: all var(--sw-duration-fast) var(--sw-ease);
  }
  .create-space-btn:hover {
    border-color: var(--sw-accent);
    color: var(--sw-accent);
  }

  .create-space-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    padding: 1rem;
    background: var(--sw-ink);
    border: 1px solid var(--sw-border);
    border-radius: var(--sw-radius-md);
  }

  .create-input, .create-select {
    font-size: var(--sw-text-sm);
    padding: 0.45rem 0.65rem;
    background: var(--sw-ink-surface);
    border: 1px solid var(--sw-border-strong);
    border-radius: var(--sw-radius-sm);
    color: var(--sw-text-primary);
    outline: none;
  }
  .create-input:focus, .create-select:focus {
    border-color: var(--sw-accent);
  }
  .create-input { flex: 1; min-width: 10rem; }
  .create-input-slug { flex: 0.6; min-width: 8rem; }
  .create-select { min-width: 7rem; }

  .create-submit {
    padding: 0.45rem 1rem;
    background: var(--sw-accent);
    color: var(--sw-ink-deep);
    border: none;
    border-radius: var(--sw-radius-sm);
    font-size: var(--sw-text-sm);
    font-weight: 500;
    cursor: pointer;
  }
  .create-submit:hover { opacity: 0.9; }

  .create-cancel {
    padding: 0.45rem 0.75rem;
    background: none;
    border: none;
    color: var(--sw-text-tertiary);
    font-size: var(--sw-text-sm);
    cursor: pointer;
  }
  .create-cancel:hover { color: var(--sw-text-primary); }

  @media (max-width: 600px) {
    .home { padding: 0.5rem 0; }
    .home-hero { padding: 1.25rem 0 1.5rem; }
    .home-title { font-size: var(--sw-text-2xl); }
    .home-subtitle { font-size: var(--sw-text-base); }
    .space-card {
      flex-wrap: wrap;
      padding: 1rem;
      gap: 0.75rem;
    }
    .space-card-icon { display: none; }
    .space-card-meta {
      order: -1;
      width: 100%;
    }
    .visibility-badge {
      font-size: 0.65rem;
    }
    .create-space-form {
      flex-direction: column;
    }
    .create-input, .create-input-slug, .create-select {
      width: 100%;
      min-width: 0;
    }
  }
</style>

<script>
  const btn = document.getElementById("create-space-btn");
  const form = document.getElementById("create-space-form") as HTMLFormElement | null;
  const cancel = document.getElementById("create-cancel");

  if (btn && form) {
    const nameInput = form.querySelector('input[name="name"]') as HTMLInputElement;
    const slugInput = form.querySelector('input[name="slug"]') as HTMLInputElement;

    btn.addEventListener("click", () => {
      btn.style.display = "none";
      form.style.display = "flex";
      nameInput.focus();
    });

    cancel?.addEventListener("click", () => {
      form.style.display = "none";
      btn.style.display = "inline-flex";
      form.reset();
    });

    // Auto-generate slug from name
    nameInput.addEventListener("input", () => {
      if (!slugInput.dataset.manual) {
        slugInput.value = nameInput.value.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
      }
    });
    slugInput.addEventListener("input", () => {
      slugInput.dataset.manual = slugInput.value ? "true" : "";
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      const res = await fetch("/spaces/create", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      if (res.ok) {
        const space = await res.json();
        window.location.href = `/s/${space.slug}`;
      } else {
        const err = await res.json().catch(() => ({ error: "Failed to create space" }));
        alert(err.error || "Failed to create space");
      }
    });
  }
</script>
