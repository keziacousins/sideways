---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Sidebar from "../../../../components/Sidebar.astro";
import Comments from "../../../../components/Comments.tsx";
import "../../../../styles/document.css";
import "../../../../styles/comments.css";

import { apiFetch } from "../../../../lib/api.ts";
import { buildNavTree } from "../../../../lib/nav.ts";
import { themeToCSS } from "../../../../lib/theme.ts";
import { icons } from "../../../../lib/icons.ts";
import { docUrl } from "@sideways/types";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:4100";
const { space: spaceSlug, section: sectionSlug, path: urlPath } = Astro.params;
const { accessToken } = Astro.locals;
const refreshToken = await Astro.session?.get("refresh_token") || null;

let space: { name: string; slug: string; canWrite?: boolean; theme?: { tokens: any } } | null = null;
let doc: {
  title: string;
  html: string;
  tags: string[];
  updatedAt: string;
  version: number;
  versionCount: number;
  versionDate: string;
  path: string;
  sectionSlug: string;
  url: string;
  id: string;
  parentId: string | null;
} | null = null;
let documents: {
  id: string;
  title: string;
  tags: string[];
  sectionId: string | null;
  sectionSlug: string;
  parentId: string | null;
  position?: number;
  unread?: boolean;
  path: string;
}[] = [];
let sections: { id: string; slug: string; title: string; parentId: string | null; position: number }[] = [];
let themes: { id: string; name: string; tokens: any }[] = [];
let rawContent = "";
let resolvedPath: string | null = null;

try {
  const spaceRes = await apiFetch(`/api/spaces/${spaceSlug}`, accessToken);
  if (spaceRes.ok) {
    space = await spaceRes.json();

    // Fetch sidebar data first so we can resolve the URL form to a stored path.
    const [docsRes, sectionsRes, themesRes] = await Promise.all([
      apiFetch(`/api/documents?space=${spaceSlug}`, accessToken),
      apiFetch(`/api/spaces/${spaceSlug}/sections`, accessToken),
      apiFetch(`/api/themes`, accessToken),
    ]);
    if (docsRes.ok) documents = await docsRes.json();
    if (sectionsRes.ok) sections = await sectionsRes.json();
    if (themesRes.ok) themes = await themesRes.json();

    // Resolve the URL path (no .md, with `index.md` collapse) to a stored path.
    // Try `<path>/index.md` first (directory form), fall back to `<path>.md`.
    // Empty URL path means the section's `index.md`.
    const candidates = urlPath
      ? [`${urlPath}/index.md`, `${urlPath}.md`]
      : ["index.md"];

    const matched = documents.find(
      (d) => d.sectionSlug === sectionSlug && candidates.includes(d.path),
    );
    resolvedPath = matched?.path ?? null;

    if (resolvedPath) {
      const [docRes, rawRes] = await Promise.all([
        apiFetch(
          `/api/documents/${spaceSlug}/${sectionSlug}/_render/${resolvedPath}`,
          accessToken,
        ),
        apiFetch(
          `/api/documents/${spaceSlug}/${sectionSlug}/${resolvedPath}`,
          accessToken,
        ),
      ]);
      if (docRes.ok) doc = await docRes.json();
      if (rawRes.ok) {
        const rawDoc = await rawRes.json();
        rawContent = rawDoc.content || "";
      }
    }
  }
} catch {
  // API not available
}

// Mark document as read (fire and forget, server-side)
if (doc && resolvedPath && accessToken) {
  apiFetch(
    `/api/documents/${spaceSlug}/${sectionSlug}/_read/${resolvedPath}`,
    accessToken,
    { method: "POST" },
  ).catch(() => {});
}

const html = doc?.html ?? "";
const navItems = buildNavTree(spaceSlug!, sections, documents);
const activeUrl = doc?.url ?? null;

// Find child pages of the current doc
const currentDoc = doc ? documents.find((d) => d.id === doc.id) : null;
const childPages = currentDoc
  ? documents
      .filter((d) => d.parentId === currentDoc.id)
      .sort((a, b) => (a.position ?? 0) - (b.position ?? 0))
      .map((d) => ({
        ...d,
        url: docUrl({ spaceSlug: spaceSlug!, sectionSlug: d.sectionSlug, path: d.path }),
      }))
  : [];
const themeCss = themeToCSS(space?.theme?.tokens);
---

<BaseLayout title={doc?.title ?? "Not Found"} sidebar={!!space}>
  <Fragment slot="sidebar">
    {space && (
      <Sidebar
        spaceSlug={spaceSlug!}
        spaceName={space.name}
        items={navItems}
        activeUrl={activeUrl}
      />
    )}
  </Fragment>

  {themeCss && <Fragment set:html={`<style>${themeCss}</style>`} />}

  {doc ? (
    <div class="doc-page">
      <div class="doc-meta-top">
        <nav class="breadcrumbs">
          <a href="/">Spaces</a>
          <span class="breadcrumb-sep">/</span>
          <a href={`/s/${spaceSlug}`}>{space?.name}</a>
          <span class="breadcrumb-sep">/</span>
          <span class="breadcrumb-current">{doc.title}</span>
        </nav>
        <div
          class="doc-tags"
          id="doc-tags"
          data-space={spaceSlug}
          data-section={sectionSlug}
          data-path={doc.path}
          data-can-write={space?.canWrite ? "true" : "false"}
        >
          {(doc.tags || []).map((tag) => (
            <span class="tag" data-tag={tag}>
              {tag}
              {space?.canWrite && <button class="tag-remove" aria-label={`Remove tag ${tag}`}>&times;</button>}
            </span>
          ))}
          {space?.canWrite && (
            <button class="tag-add" id="tag-add-btn" title="Add tag">+</button>
          )}
        </div>
      </div>

      <div class="doc-toolbar">
        <div class="doc-toolbar-left">
          <button class="doc-version" id="version-info" title={`Last updated ${new Date(doc.versionDate).toLocaleString()}`}>
            <Fragment set:html={icons.clock(13)} />
            v{doc.version} · {doc.versionCount} version{doc.versionCount !== 1 ? 's' : ''} · {new Date(doc.versionDate).toLocaleDateString()}
          </button>
        </div>
        <div class="doc-toolbar-right">
          {space?.canWrite && (
            <button class="toolbar-btn" id="edit-toggle" title="Edit">
              <Fragment set:html={icons.edit(15)} />
            </button>
          )}
          <button class="toolbar-btn" id="copy-markdown" title="Copy as markdown">
            <Fragment set:html={icons.copy(15)} />
          </button>
          {accessToken && (
            <button class="toolbar-btn" id="watch-toggle" title="Watch this document">
              <Fragment set:html={icons.bell(15)} />
            </button>
          )}
          <Comments
            client:load
            spaceSlug={spaceSlug!}
            sectionSlug={sectionSlug!}
            path={doc.path}
            apiUrl={API_URL}
            accessToken={accessToken}
            refreshToken={refreshToken}
          />
          <div class="doc-actions-menu" id="doc-actions-menu">
            <button class="toolbar-btn" id="actions-toggle" title="More actions">
              <Fragment set:html={icons.more(15)} />
            </button>
            <div class="actions-dropdown" id="actions-dropdown" style="display: none;">
              <button class="action-item" id="action-pdf">
                <Fragment set:html={icons.document(14)} />
                Download PDF&hellip;
              </button>
              {space?.canWrite && (
                <>
                  <div class="action-divider"></div>
                  <button class="action-item" id="action-rename">
                    <Fragment set:html={icons.pencil(14)} />
                    Rename
                  </button>
                  <button class="action-item" id="action-duplicate">
                    <Fragment set:html={icons.duplicate(14)} />
                    Duplicate
                  </button>
                  {sections.length > 0 && (
                    <div class="action-submenu-wrap">
                      <button class="action-item" id="action-move">
                        <Fragment set:html={icons.document(14)} />
                        Move to&hellip;
                      </button>
                      <div class="submenu-dropdown" id="move-submenu" style="display: none;">
                        {sections.map((s) => (
                          <button class="submenu-item" data-target-section={s.slug}>
                            {s.title} {s.slug === sectionSlug ? '(current)' : ''}
                          </button>
                        ))}
                      </div>
                    </div>
                  )}
                  <button class="action-item action-danger" id="action-delete">
                    <Fragment set:html={icons.trash(14)} />
                    Delete
                  </button>
                </>
              )}
            </div>
          </div>
        </div>
      </div>

      <article class="sw-doc-content" id="doc-view">
        <Fragment set:html={html} />
      </article>

      {childPages.length > 0 && (
        <nav class="child-pages">
          <h3 class="child-pages-heading">In this section</h3>
          <ul class="child-pages-list">
            {childPages.map((child) => (
              <li>
                <a href={child.url} class="child-page-link">
                  <Fragment set:html={icons.documentSimple(14)} />
                  <span>{child.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div class="doc-editor" id="doc-editor" style="display: none;">
        <div class="editor-panes">
          <div class="editor-input">
            <textarea id="editor-textarea" spellcheck="true"></textarea>
          </div>
          <div class="editor-preview">
            <div class="sw-doc-content" id="editor-preview-content"></div>
          </div>
        </div>
        <div class="editor-floating-bar">
          <button type="button" class="editor-cancel" id="editor-cancel">Cancel</button>
          <button type="button" class="editor-save" id="editor-save">Save</button>
        </div>
      </div>
    </div>
  ) : (
    <div class="not-found">
      <h1>Document not found</h1>
      <a href={`/s/${spaceSlug}`}>Back to {space?.name || "space"}</a>
    </div>
  )}

  <!-- PDF download modal -->
  <div class="pdf-overlay" id="pdf-overlay" style="display: none;">
    <div class="pdf-modal">
      <div class="pdf-modal-header">
        <h3>Download PDF</h3>
        <button class="pdf-modal-close" id="pdf-modal-close">&times;</button>
      </div>
      <div class="pdf-modal-body">
        <div class="pdf-field">
          <label for="pdf-theme">Print theme</label>
          <select id="pdf-theme">
            <option value="">Space default</option>
            {themes.map((t) => (
              <option value={t.id}>{t.name}</option>
            ))}
          </select>
        </div>
        <div class="pdf-field pdf-checks">
          <label>
            <input type="checkbox" id="pdf-cover" checked />
            Cover page
          </label>
          <label>
            <input type="checkbox" id="pdf-toc" checked />
            Table of contents
          </label>
        </div>
      </div>
      <div class="pdf-modal-footer">
        <button class="pdf-btn-download" id="pdf-btn-download">Download</button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .doc-page { max-width: var(--sw-content-max); }

  .doc-meta-top {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: 0.5rem 1rem; margin-bottom: 0.5rem;
  }

  .breadcrumbs {
    display: flex; align-items: center; gap: 0.4rem;
    font-size: var(--sw-text-sm); color: var(--sw-text-tertiary);
  }
  .breadcrumbs a { color: var(--sw-text-tertiary); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--sw-accent); }
  .breadcrumb-sep { color: var(--sw-text-ghost); }
  .breadcrumb-current { color: var(--sw-text-secondary); }

  .doc-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .tag {
    display: inline-flex; align-items: center; gap: 0.25em;
    font-size: var(--sw-text-xs); padding: 0.15em 0.5em;
    background: var(--sw-ink-surface); border-radius: var(--sw-radius-sm);
    color: var(--sw-text-secondary);
  }
  .tag-remove {
    background: none; border: none; color: var(--sw-text-ghost);
    cursor: pointer; font-size: 1em; line-height: 1; padding: 0; margin-left: -0.1em;
  }
  .tag-remove:hover { color: var(--sw-text-primary); }
  .tag-add {
    display: inline-flex; align-items: center; justify-content: center;
    font-size: var(--sw-text-xs); width: 1.5em; height: 1.5em; padding: 0;
    background: none; border: 1px dashed var(--sw-border-strong);
    border-radius: var(--sw-radius-sm); color: var(--sw-text-ghost); cursor: pointer;
  }
  .tag-add:hover { color: var(--sw-text-secondary); border-color: var(--sw-text-ghost); }
  .tag-input {
    font-size: var(--sw-text-xs); padding: 0.15em 0.4em;
    background: var(--sw-ink); border: 1px solid var(--sw-border-strong);
    border-radius: var(--sw-radius-sm); color: var(--sw-text-primary);
    color-scheme: dark; outline: none; width: 6em;
  }
  .tag-input:focus { border-color: var(--sw-accent); }

  .doc-toolbar {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 1rem; padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--sw-border);
    position: sticky; top: var(--sw-header-height);
    background: var(--sw-ink-deep); z-index: 10;
    padding-top: 0.5rem; margin-top: -0.5rem;
  }
  .doc-toolbar-right { display: flex; align-items: center; gap: 0.5rem; }
  .toolbar-btn {
    display: flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; padding: 0; background: none; border: none;
    border-radius: var(--sw-radius-sm); color: var(--sw-text-tertiary);
    cursor: pointer; transition: all var(--sw-duration-fast) var(--sw-ease);
  }
  .toolbar-btn:hover { color: var(--sw-text-primary); background: var(--sw-ink-lighter); }
  .toolbar-btn.watching { color: var(--sw-accent); background: var(--sw-accent-glow); }
  .toolbar-btn.watching svg path:first-child { fill: var(--sw-accent); }

  .doc-actions-menu { position: relative; }
  .actions-dropdown {
    position: absolute; top: 100%; right: 0; margin-top: 0.35rem;
    background: var(--sw-ink); border: 1px solid var(--sw-border-strong);
    border-radius: var(--sw-radius-md); box-shadow: var(--sw-shadow-lg);
    min-width: 160px; z-index: 50; padding: 0.25rem;
  }
  .action-item {
    display: flex; align-items: center; gap: 0.5rem; width: 100%;
    padding: 0.45rem 0.65rem; background: none; border: none;
    border-radius: var(--sw-radius-sm); color: var(--sw-text-secondary);
    font-family: var(--sw-font-body); font-size: var(--sw-text-sm);
    cursor: pointer; text-align: left;
  }
  .action-item:hover { background: var(--sw-ink-light); color: var(--sw-text-primary); }
  .action-item.action-danger:hover { background: rgba(248, 113, 113, 0.08); color: var(--sw-error); }

  .action-submenu-wrap { position: relative; }
  .submenu-dropdown {
    position: absolute; right: 100%; top: 0; margin-right: 0.25rem;
    background: var(--sw-ink); border: 1px solid var(--sw-border-strong);
    border-radius: var(--sw-radius-md); box-shadow: var(--sw-shadow-lg);
    min-width: 160px; z-index: 51; padding: 0.25rem;
  }
  .submenu-item {
    display: block; width: 100%; padding: 0.4rem 0.65rem;
    background: none; border: none; border-radius: var(--sw-radius-sm);
    color: var(--sw-text-secondary); font-family: var(--sw-font-body);
    font-size: var(--sw-text-sm); cursor: pointer; text-align: left; white-space: nowrap;
  }
  .submenu-item:hover { background: var(--sw-ink-light); color: var(--sw-text-primary); }

  .doc-toolbar-left { display: flex; align-items: center; }
  .doc-version {
    display: flex; align-items: center; gap: 0.35rem;
    padding: 0.25rem 0.5rem; background: none;
    border: 1px solid transparent; border-radius: var(--sw-radius-sm);
    color: var(--sw-text-secondary); font-size: var(--sw-text-xs);
    font-family: var(--sw-font-body); cursor: pointer;
    transition: all var(--sw-duration-fast) var(--sw-ease);
  }
  .doc-version:hover {
    color: var(--sw-text-primary); border-color: var(--sw-border);
    background: var(--sw-ink-light);
  }
  .action-divider { height: 1px; background: var(--sw-border); margin: 0.2rem 0.4rem; }

  .pdf-overlay {
    position: fixed; inset: 0; background: rgba(8, 9, 12, 0.5); z-index: 300;
    display: flex; align-items: center; justify-content: center;
  }
  .pdf-modal {
    width: 100%; max-width: 340px; background: var(--sw-ink);
    border: 1px solid rgba(255, 255, 255, 0.18); border-radius: var(--sw-radius-lg);
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.4); overflow: hidden;
  }
  .pdf-modal-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.85rem 1rem; border-bottom: 1px solid var(--sw-border);
  }
  .pdf-modal-header h3 {
    margin: 0; font-size: var(--sw-text-sm); font-weight: 600;
    color: var(--sw-text-primary);
  }
  .pdf-modal-close {
    background: none; border: none; color: var(--sw-text-ghost);
    font-size: 1.2rem; cursor: pointer; padding: 0 0.2rem; line-height: 1;
  }
  .pdf-modal-close:hover { color: var(--sw-text-primary); }
  .pdf-modal-body { padding: 1rem; display: flex; flex-direction: column; gap: 0.85rem; }
  .pdf-field { display: flex; flex-direction: column; gap: 0.3rem; }
  .pdf-field > label {
    font-size: var(--sw-text-xs); color: var(--sw-text-tertiary);
    font-weight: 500; text-transform: uppercase; letter-spacing: 0.03em;
  }
  .pdf-field select {
    background: var(--sw-ink-light); border: 1px solid var(--sw-border);
    border-radius: var(--sw-radius-sm); color: var(--sw-text-primary);
    font-size: var(--sw-text-sm); padding: 0.4rem 0.5rem;
    font-family: var(--sw-font-body); width: 100%;
  }
  .pdf-checks { flex-direction: row; gap: 1rem; }
  .pdf-checks label {
    display: flex; align-items: center; gap: 0.35rem;
    font-size: var(--sw-text-sm); color: var(--sw-text-secondary);
    cursor: pointer; text-transform: none; letter-spacing: 0; font-weight: 400;
  }
  .pdf-checks input[type="checkbox"] { accent-color: var(--sw-accent); }
  .pdf-modal-footer {
    padding: 0.75rem 1rem; border-top: 1px solid var(--sw-border);
    display: flex; justify-content: flex-end;
  }
  .pdf-btn-download {
    background: var(--sw-accent); color: var(--sw-ink-deepest); border: none;
    border-radius: var(--sw-radius-sm); padding: 0.45rem 1.2rem;
    font-size: var(--sw-text-sm); font-weight: 500;
    font-family: var(--sw-font-body); cursor: pointer;
    transition: opacity var(--sw-duration-fast) var(--sw-ease);
  }
  .pdf-btn-download:hover { opacity: 0.85; }

  @media (max-width: 600px) {
    .doc-meta-top { flex-direction: column; align-items: flex-start; gap: 0.35rem; }
    .breadcrumbs { font-size: var(--sw-text-xs); }
    .tag-remove { display: none; }
    .tag-add { display: none; }
    #edit-toggle, #copy-markdown, .doc-version { display: none; }
  }

  .child-pages {
    margin-top: 3rem; padding-top: 2rem;
    border-top: 1px solid var(--sw-border);
    max-width: var(--sw-content-max);
  }
  .child-pages-heading {
    font-family: var(--sw-font-display); font-size: var(--sw-text-sm);
    font-weight: 500; color: var(--sw-text-tertiary);
    text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.75rem;
  }
  .child-pages-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .child-page-link {
    display: flex; align-items: center; gap: 0.6rem;
    padding: 0.6rem 0.75rem; border-radius: var(--sw-radius-sm);
    color: var(--sw-text-secondary); text-decoration: none;
    transition: all var(--sw-duration-fast) var(--sw-ease);
  }
  .child-page-link:hover { background: var(--sw-ink-light); color: var(--sw-text-primary); }
  .child-page-link svg { color: var(--sw-text-tertiary); flex-shrink: 0; }

  .doc-editor {
    display: flex; flex-direction: column;
    height: calc(100vh - var(--sw-header-height) - var(--sw-page-pad-y) - 5rem);
    min-height: 300px; position: relative; overflow: hidden;
  }
  .editor-panes {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1px;
    background: var(--sw-border); border: 1px solid var(--sw-border);
    border-radius: var(--sw-radius-md); overflow: hidden;
    flex: 1; min-height: 0;
  }
  .editor-input { background: var(--sw-ink-deepest); overflow: hidden; }
  .editor-input textarea {
    width: 100%; height: 100%; padding: 1.25rem; background: transparent;
    border: none; color: var(--sw-text-primary);
    font-family: var(--sw-font-mono); font-size: var(--sw-text-sm);
    line-height: 1.7; resize: none; outline: none; tab-size: 2;
  }
  .editor-preview { background: var(--sw-ink); padding: 1.25rem; overflow-y: auto; }
  .editor-floating-bar {
    position: fixed; bottom: 1.5rem; left: 50%; transform: translateX(-50%);
    display: flex; gap: 0.5rem; padding: 0.5rem 1rem;
    background: var(--sw-ink); border: 1px solid var(--sw-border-strong);
    border-radius: var(--sw-radius-lg); box-shadow: var(--sw-shadow-lg);
    z-index: 50;
  }
  .editor-cancel {
    padding: 0.45rem 1rem; background: none;
    border: 1px solid var(--sw-border); border-radius: var(--sw-radius-md);
    color: var(--sw-text-secondary); font-family: var(--sw-font-body);
    font-size: var(--sw-text-sm); cursor: pointer;
  }
  .editor-cancel:hover { border-color: var(--sw-border-strong); color: var(--sw-text-primary); }
  .editor-save {
    padding: 0.45rem 1.25rem; background: var(--sw-accent);
    color: var(--sw-ink-deepest); border: none;
    border-radius: var(--sw-radius-md); font-family: var(--sw-font-body);
    font-size: var(--sw-text-sm); font-weight: 600; cursor: pointer;
  }
  .editor-save:hover { background: var(--sw-accent-strong); }
  .editor-save:disabled { opacity: 0.6; cursor: not-allowed; }

  @media (max-width: 800px) {
    .editor-panes { grid-template-columns: 1fr; }
    .editor-preview { display: none; }
  }

  .not-found { padding: 4rem 0; text-align: center; }
  .not-found h1 { font-family: var(--sw-font-display); margin-bottom: 1rem; }
</style>

<style is:global>
  .doc-tags .tag {
    display: inline-flex; align-items: center; gap: 0.25em;
    font-size: var(--sw-text-xs); padding: 0.15em 0.5em;
    background: var(--sw-ink-surface); border-radius: var(--sw-radius-sm);
    color: var(--sw-text-secondary);
  }
  .doc-tags .tag-remove {
    background: none; border: none; color: var(--sw-text-ghost);
    cursor: pointer; font-size: 1em; line-height: 1; padding: 0; margin-left: -0.1em;
  }
  .doc-tags .tag-remove:hover { color: var(--sw-text-primary); }
  .doc-tags .tag-add {
    display: inline-flex; align-items: center; justify-content: center;
    font-size: var(--sw-text-xs); width: 1.5em; height: 1.5em; padding: 0;
