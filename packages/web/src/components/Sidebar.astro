---
import type { NavItem } from "../lib/nav.ts";
import NavTree from "./NavTree.astro";

interface Props {
  spaceSlug: string;
  spaceName: string;
  items: NavItem[];
  activeSlug?: string;
}

const { spaceSlug, spaceName, items, activeSlug } = Astro.props;
---

<nav class="sidebar-nav">
  <div class="sidebar-header">
    <a href={`/s/${spaceSlug}`} class="sidebar-space-name">{spaceName}</a>
  </div>

  <NavTree spaceSlug={spaceSlug} items={items} activeSlug={activeSlug} />
</nav>

<style is:global>
  .sidebar-nav {
    font-size: var(--sw-text-sm);
  }

  .sidebar-header {
    padding: 0 1.25rem 1rem;
    border-bottom: 1px solid var(--sw-border);
    margin-bottom: 0.75rem;
  }

  .sidebar-space-name {
    font-family: var(--sw-font-display);
    font-size: var(--sw-text-base);
    font-weight: 500;
    color: var(--sw-text-primary);
    text-decoration: none;
  }

  .sidebar-space-name:hover { color: var(--sw-accent); }

  .nav-children {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .nav-tree-root { /* top-level <ul> hook for future use */ }

  .nav-item {
    margin: 0;
    position: relative;
  }

  .nav-item.unread > .nav-link::after,
  .nav-item.unread > details > .nav-directory .nav-link-inline::after {
    content: "●";
    font-size: 6px;
    color: var(--sw-accent);
    margin-left: 0.35rem;
    vertical-align: middle;
  }

  .nav-section {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 1.25rem;
    margin-top: 0.75rem;
    color: var(--sw-text-secondary);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: var(--sw-text-xs);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .nav-item:first-child > details > .nav-section { margin-top: 0; }
  .nav-section:hover { color: var(--sw-text-primary); }
  .nav-section::-webkit-details-marker { display: none; }

  .nav-directory {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .nav-directory::-webkit-details-marker { display: none; }
  .nav-directory-label {
    color: var(--sw-text-secondary);
    font-weight: 500;
  }

  .chevron {
    transition: transform var(--sw-duration) var(--sw-ease);
    flex-shrink: 0;
  }
  details[open] > .nav-section .chevron,
  details[open] > .nav-directory .chevron {
    transform: rotate(90deg);
  }

  .nav-link {
    display: block;
    padding: 0.35rem 1.25rem;
    color: var(--sw-text-secondary);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: all var(--sw-duration-fast) var(--sw-ease);
  }
  .nav-link:hover { color: var(--sw-text-primary); background: var(--sw-ink-light); }
  .nav-link-inline {
    display: inline-block;
    padding: 0.1rem 0.25rem;
    color: var(--sw-text-secondary);
    text-decoration: none;
    transition: color var(--sw-duration-fast) var(--sw-ease);
  }
  .nav-link-inline:hover { color: var(--sw-text-primary); }

  /* Indentation: each depth adds ~1.25rem. Capped at 4 levels of explicit
     styling; deeper still works, just stops getting more indented. */
  .nav-depth-0 { padding-left: 1.25rem; }
  .nav-depth-1 { padding-left: 2.5rem; }
  .nav-depth-2 { padding-left: 3.75rem; }
  .nav-depth-3 { padding-left: 5rem; }
  .nav-depth-4 { padding-left: 6.25rem; }

  /* Directory header padding follows the same scale, slightly tighter. */
  .nav-directory.nav-depth-1 { padding-left: 1.25rem; }
  .nav-directory.nav-depth-2 { padding-left: 2.5rem; }
  .nav-directory.nav-depth-3 { padding-left: 3.75rem; }
  .nav-directory.nav-depth-4 { padding-left: 5rem; }

  .nav-item.active > .nav-link,
  .nav-item.active > details > .nav-directory .nav-link-inline {
    color: var(--sw-accent);
    border-left-color: var(--sw-accent);
    background: var(--sw-accent-glow);
  }
</style>
