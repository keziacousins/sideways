---
interface Comment {
  id: string;
  body: string;
  anchorText: string | null;
  parentId: string | null;
  resolved: boolean;
  createdAt: string;
  author: { name: string; email: string } | null;
}

interface Props {
  comments: Comment[];
  spaceSlug: string;
  docSlug: string;
}

const { comments, spaceSlug, docSlug } = Astro.props;

// Group into threads: top-level + their replies
const topLevel = comments.filter((c) => !c.parentId);
const replies = comments.filter((c) => c.parentId);
const replyMap = new Map<string, Comment[]>();
for (const r of replies) {
  const list = replyMap.get(r.parentId!) || [];
  list.push(r);
  replyMap.set(r.parentId!, list);
}
---

<div class="comments-panel">
  <div class="comments-header">
    <h3>Comments</h3>
    <span class="comment-count">{topLevel.length}</span>
  </div>

  {topLevel.length === 0 ? (
    <div class="comments-empty">
      <p>No comments yet</p>
      <p class="comments-empty-hint">Select text to add an inline comment</p>
    </div>
  ) : (
    <div class="comments-list">
      {topLevel.map((comment) => (
        <div class:list={["comment-thread", { resolved: comment.resolved }]}>
          <div class="comment">
            {comment.anchorText && (
              <div class="comment-anchor">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                </svg>
                <span>{comment.anchorText.slice(0, 60)}{comment.anchorText.length > 60 ? "…" : ""}</span>
              </div>
            )}
            <div class="comment-meta">
              <span class="comment-author">{comment.author?.name || "Unknown"}</span>
              <span class="comment-date">{new Date(comment.createdAt).toLocaleDateString()}</span>
            </div>
            <div class="comment-body">{comment.body}</div>
          </div>

          {(replyMap.get(comment.id) || []).map((reply) => (
            <div class="comment reply">
              <div class="comment-meta">
                <span class="comment-author">{reply.author?.name || "Unknown"}</span>
                <span class="comment-date">{new Date(reply.createdAt).toLocaleDateString()}</span>
              </div>
              <div class="comment-body">{reply.body}</div>
            </div>
          ))}
        </div>
      ))}
    </div>
  )}
</div>

<style>
  .comments-panel {
    font-size: var(--sw-text-sm);
  }

  .comments-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--sw-border);
    margin-bottom: 1rem;
  }

  .comments-header h3 {
    font-family: var(--sw-font-display);
    font-size: var(--sw-text-base);
    font-weight: 500;
    color: var(--sw-text-primary);
  }

  .comment-count {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 0.35em;
    background: var(--sw-ink-surface);
    border-radius: 10px;
    font-size: var(--sw-text-xs);
    font-weight: 600;
    color: var(--sw-text-secondary);
  }

  .comments-empty {
    text-align: center;
    padding: 2rem 0;
    color: var(--sw-text-ghost);
  }

  .comments-empty-hint {
    font-size: var(--sw-text-xs);
    margin-top: 0.5rem;
  }

  .comments-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .comment-thread {
    border: 1px solid var(--sw-border);
    border-radius: var(--sw-radius-md);
    overflow: hidden;
    transition: border-color var(--sw-duration) var(--sw-ease);
  }

  .comment-thread:hover {
    border-color: var(--sw-border-strong);
  }

  .comment-thread.resolved {
    opacity: 0.5;
  }

  .comment {
    padding: 0.75rem 1rem;
  }

  .reply {
    border-top: 1px solid var(--sw-border);
    padding-left: 1.5rem;
    background: var(--sw-ink);
  }

  .comment-anchor {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.5rem;
    margin-bottom: 0.5rem;
    background: var(--sw-accent-glow);
    border-radius: var(--sw-radius-sm);
    color: var(--sw-accent);
    font-size: var(--sw-text-xs);
    font-family: var(--sw-font-mono);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .comment-anchor svg {
    flex-shrink: 0;
  }

  .comment-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .comment-author {
    font-weight: 600;
    color: var(--sw-text-primary);
    font-size: var(--sw-text-xs);
  }

  .comment-date {
    color: var(--sw-text-ghost);
    font-size: var(--sw-text-xs);
  }

  .comment-body {
    color: var(--sw-text-secondary);
    line-height: 1.5;
  }
</style>
