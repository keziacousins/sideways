---
import "@fontsource-variable/inter";
import "@fontsource-variable/fira-code";
import "@fontsource-variable/newsreader";
import "../styles/global.css";
import "../styles/notifications.css";
import "../styles/search.css";
import "../styles/wiki-autocomplete.css";
import Header from "../components/Header.astro";
import SearchModal from "../components/SearchModal.tsx";
import WikiLinkAutocomplete from "../components/WikiLinkAutocomplete.tsx";

interface Props {
  title: string;
  sidebar?: boolean;
}

const { title, sidebar = false } = Astro.props;
const accessToken = Astro.locals.accessToken || null;
const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:4100";
// Extract space slug from URL path (e.g. /s/engineering/doc-slug → engineering)
const pathParts = Astro.url.pathname.split("/");
const spaceSlug = pathParts[1] === "s" ? pathParts[2] : null;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Sideways</title>
  </head>
  <body>
    <Header />
    <SearchModal client:idle apiUrl={API_URL} accessToken={accessToken} />
    {spaceSlug && <WikiLinkAutocomplete client:idle apiUrl={API_URL} spaceSlug={spaceSlug} accessToken={accessToken} />}
    <div class:list={["sw-shell", { "has-sidebar": sidebar }]}>
      {sidebar && (
        <aside class="sw-sidebar" id="sidebar">
          <slot name="sidebar" />
        </aside>
      )}
      <main class="sw-main">
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .sw-shell {
    display: flex;
    min-height: calc(100vh - var(--sw-header-height));
    margin-top: var(--sw-header-height);
  }

  .sw-main {
    flex: 1;
    min-width: 0;
    padding: var(--sw-page-pad);
    position: relative;
    z-index: 1;
  }

  .sw-sidebar {
    position: sticky;
    top: var(--sw-header-height);
    width: var(--sw-sidebar-width);
    height: calc(100vh - var(--sw-header-height));
    flex-shrink: 0;
    overflow-y: auto;
    border-right: 1px solid var(--sw-border);
    background: var(--sw-ink-deepest);
    padding: 1.25rem 0;
    animation: slideInLeft var(--sw-duration-slow) var(--sw-ease) both;
  }

  .sw-sidebar {
    transition: width var(--sw-duration) var(--sw-ease),
                opacity var(--sw-duration) var(--sw-ease),
                padding var(--sw-duration) var(--sw-ease);
  }

  @media (max-width: 900px) {
    .sw-sidebar {
      display: none;
    }
    .sw-main {
      padding: 1rem;
    }
  }

  /* Collapse sidebar when comments panel is open on mid-width screens */
  @media (max-width: 1200px) and (min-width: 901px) {
    :global(html.comments-open) .sw-sidebar {
      width: 0;
      opacity: 0;
      padding: 0;
      overflow: hidden;
      border-right: none;
    }
  }
</style>

<script>
  // Persist sidebar scroll position across page navigations
  const sidebar = document.getElementById("sidebar");
  if (sidebar) {
    const key = "sw-sidebar-scroll";
    const saved = sessionStorage.getItem(key);
    if (saved) {
      sidebar.scrollTop = parseInt(saved, 10);
    }
    // Save on any link click within sidebar (before navigation)
    sidebar.addEventListener("click", (e) => {
      const link = (e.target as HTMLElement).closest("a");
      if (link) {
        sessionStorage.setItem(key, String(sidebar.scrollTop));
      }
    });
  }
</script>
