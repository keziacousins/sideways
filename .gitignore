# Dependencies & build output
node_modules/
dist/
.astro/
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example

# OS
.DS_Store

# Editor / agent local config
.claude/
.mcp.json

# Local Sideways CLI sync state and per-checkout config
.sideways/
.sideways.yml

# Local-only working files
references/
backups/

# Uncommitted brand assets (logos, licensed fonts, per-client theme config).
# Single source of truth; scripts/sync-brand-assets.sh copies fonts from here
# into the build locations below. Reaches the deploy host via deploy.sh rsync.
brand/

# Mirrored from brand/ by sync-brand-assets.sh — never commit font binaries
# here. The mirror prunes, so a committed file would be deleted on the next
# sync as well as being invisible to git; redistributable fonts are fetched at
# image-build time instead (see user-docs/themes.md).
# The WeasyPrint directory itself stays tracked (via .gitkeep) because the
# image's `COPY fonts/` fails the build if it is missing on a fresh clone.
packages/web/public/fonts/
infra/weasyprint/fonts/*
!infra/weasyprint/fonts/.gitkeep

