{
  "name": "sideways",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "description": "Neither markup nor markdown, but something else entirely.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "typecheck": "pnpm -r exec tsc --noEmit"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "axios": "^1.18.0",
      "defu": "^6.1.5",
      "devalue": "^5.8.1",
      "fast-uri": "^3.1.6",
      "follow-redirects": "^1.16.0",
      "ip-address": "^10.3.1",
      "path-to-regexp": "^8.4.0",
      "postcss": "^8.5.18",
      "esbuild": "^0.27.4",
      "@hono/node-server": "^1.19.13",
      "sharp": "^0.35.4"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "postgres": "^3.4.9",
    "tsx": "^4.23.13",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource-variable/fira-code": "^5.3.0"
  }
}
