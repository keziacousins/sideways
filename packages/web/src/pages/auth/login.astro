---
import BaseLayout from "../../layouts/BaseLayout.astro";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:4100";

const loginChallenge = Astro.url.searchParams.get("login_challenge");
const error = Astro.url.searchParams.get("error");
const returnTo = Astro.url.searchParams.get("returnTo") || "/";
---

<BaseLayout title="Sign in">
  <div class="auth-page">
    <div class="auth-card animate-in">
      <div class="auth-logo">
        <span class="logo-mark">S</span>
      </div>
      <h1>Sign in to Sideways</h1>
      <p class="auth-subtitle">Enter your credentials to continue</p>

      {error && <div class="auth-error">{decodeURIComponent(error)}</div>}

      <form id="login-form" class="auth-form" action="/auth/login" method="POST">
        <div class="form-field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" autocomplete="username email" placeholder="you@example.com" required autofocus />
        </div>
        <div class="form-field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" autocomplete="current-password" placeholder="••••••••" required />
        </div>
        <button type="submit" class="auth-submit">Sign in</button>
      </form>

      <p class="auth-alt">
        Don't have an account? <a href={`/auth/signup?returnTo=${encodeURIComponent(returnTo)}${loginChallenge ? `&login_challenge=${encodeURIComponent(loginChallenge)}` : ""}`}>Create one</a>
      </p>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ API_URL, loginChallenge, returnTo }}>
  const form = document.getElementById("login-form");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const email = formData.get("email");
    const password = formData.get("password");
    const btn = form.querySelector("button");
    btn.textContent = "Signing in…";
    btn.disabled = true;

    try {
      const res = await fetch(`${API_URL}/api/auth/login`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, password }),
      });

      const data = await res.json();
      if (!res.ok) {
        alert(data.error || "Login failed");
        btn.textContent = "Sign in";
        btn.disabled = false;
        return;
      }

      // Preserve any in-flight OAuth login challenge so /authorize can
      // resume the original flow (e.g. an MCP connector add) rather than
      // restarting a fresh sideways-web flow that abandons it.
      const params = new URLSearchParams({ nonce: data.nonce, returnTo });
      if (loginChallenge) params.set("login_challenge", loginChallenge);
      window.location.href = `${API_URL}/api/auth/authorize?${params.toString()}`;
    } catch (err) {
      alert("Connection error. Is the API server running?");
      btn.textContent = "Sign in";
      btn.disabled = false;
    }
  });
</script>

<style>
  .auth-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - var(--sw-header-height) - 4rem);
  }

  .auth-card {
    width: 100%;
    max-width: 380px;
    padding: 2.5rem;
    background: var(--sw-ink);
    border: 1px solid var(--sw-border);
    border-radius: var(--sw-radius-lg);
  }

  .auth-logo {
    margin-bottom: 1.5rem;
  }

  .auth-logo .logo-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--sw-accent);
    color: var(--sw-ink-deepest);
    border-radius: var(--sw-radius-md);
    font-family: var(--sw-font-display);
    font-weight: 600;
    font-size: var(--sw-text-xl);
  }

  .auth-card h1 {
    font-family: var(--sw-font-display);
    font-size: var(--sw-text-2xl);
    font-weight: 400;
    margin-bottom: 0.35rem;
  }

  .auth-subtitle {
    color: var(--sw-text-tertiary);
    font-size: var(--sw-text-sm);
    margin-bottom: 2rem;
  }

  .auth-error {
    padding: 0.6rem 0.85rem;
    margin-bottom: 1.25rem;
    background: rgba(248, 113, 113, 0.08);
    border: 1px solid rgba(248, 113, 113, 0.2);
    border-radius: var(--sw-radius-md);
    color: var(--sw-error);
    font-size: var(--sw-text-sm);
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-field label {
    font-size: var(--sw-text-sm);
    font-weight: 500;
    color: var(--sw-text-secondary);
  }

  .form-field input {
    padding: 0.6rem 0.85rem;
    background: var(--sw-ink-deep);
    border: 1px solid var(--sw-border-strong);
    border-radius: var(--sw-radius-md);
    color: var(--sw-text-primary);
    font-family: var(--sw-font-body);
    font-size: var(--sw-text-base);
    transition: border-color var(--sw-duration-fast) var(--sw-ease);
  }

  .form-field input::placeholder {
    color: var(--sw-text-ghost);
  }

  .form-field input:focus {
    outline: none;
    border-color: var(--sw-accent);
    box-shadow: 0 0 0 3px var(--sw-accent-glow);
  }

  .auth-submit {
    margin-top: 0.5rem;
    padding: 0.65rem;
    background: var(--sw-accent);
    color: var(--sw-ink-deepest);
    border: none;
    border-radius: var(--sw-radius-md);
    font-family: var(--sw-font-body);
    font-size: var(--sw-text-base);
    font-weight: 600;
    cursor: pointer;
    transition: all var(--sw-duration-fast) var(--sw-ease);
  }

  .auth-submit:hover {
    background: var(--sw-accent-strong);
    box-shadow: var(--sw-shadow-glow);
  }

  .auth-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .auth-alt {
    margin-top: 1.5rem;
    text-align: center;
    font-size: var(--sw-text-sm);
    color: var(--sw-text-tertiary);
  }

  .auth-alt a {
    color: var(--sw-accent);
  }
</style>
