{doc && (
<script>
  // External anchor links use bare fragments ('#foo'), but the markdown
  // renderer prefixes all element ids with 'user-content-' to defend
  // against DOM-clobber attacks via user content. When someone follows
  // a deep link with a bare fragment, find the prefixed element and
  // scroll to it.
  function scrollToPrefixedAnchor(): void {
    const hash = location.hash.slice(1);
    if (!hash) return;
    if (document.getElementById(hash)) return; // bare anchor already resolves
    const prefixed = document.getElementById("user-content-" + hash);
    if (prefixed) prefixed.scrollIntoView();
  }
  window.addEventListener("DOMContentLoaded", scrollToPrefixedAnchor);
  window.addEventListener("hashchange", scrollToPrefixedAnchor);
</script>

<script>
  // Mermaid fences arrive as `<pre data-mermaid>` placeholders and are drawn
  // in the browser. The module below only fetches mermaid itself when the
  // page really has a diagram, so most documents pay nothing for this.
  import { renderMermaidDiagrams } from "../../../../scripts/mermaid.ts";

  renderMermaidDiagrams();
  // The editor's live preview swaps its pane's HTML wholesale on every
  // keystroke-debounced re-render, which drops any SVG we drew before.
  document.addEventListener("sideways:preview-rendered", () => renderMermaidDiagrams());
</script>

<script>
  // Watch toggle — swap between outline and filled bell
  const watchBtn = document.getElementById("watch-toggle") as HTMLButtonElement | null;
  if (watchBtn) {
    const docTags = document.getElementById("doc-tags") as HTMLElement | null;
    const spaceSlug = docTags?.dataset.space ?? "";
    const sectionSlug = docTags?.dataset.section ?? "";
    const path = docTags?.dataset.path ?? "";

    const bellOutline = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-0.125em"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>`;
    const bellFilled = `<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" style="vertical-align:-0.125em"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>`;

    function setWatchState(watching: boolean) {
      watchBtn!.innerHTML = watching ? bellFilled : bellOutline;
      watchBtn!.classList.toggle("watching", watching);
      watchBtn!.title = watching ? "Unwatch this document" : "Watch this document";
    }

    const watchUrl = `/op/doc-watch?space=${encodeURIComponent(spaceSlug)}&section=${encodeURIComponent(sectionSlug)}&path=${encodeURIComponent(path)}`;
    fetch(watchUrl).then(r => r.json()).then(data => setWatchState(data.watching)).catch(() => {});

    watchBtn.addEventListener("click", async () => {
      const res = await fetch(`/op/doc-watch`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ space: spaceSlug, section: sectionSlug, path }),
      });
      if (res.ok) {
        const data = await res.json();
        setWatchState(data.watching);
      }
    });
  }

  // Tag editor
  const tagsEl = document.getElementById("doc-tags") as HTMLElement | null;
  if (tagsEl && tagsEl.dataset.canWrite === "true") {
    const spaceSlug = tagsEl.dataset.space ?? "";
    const sectionSlug = tagsEl.dataset.section ?? "";
    const path = tagsEl.dataset.path ?? "";
    const addBtn = document.getElementById("tag-add-btn");

    function getCurrentTags(): string[] {
      return Array.from(tagsEl!.querySelectorAll<HTMLElement>(".tag[data-tag]")).map(el => el.dataset.tag ?? "");
    }

    async function saveTags(tags: string[]) {
      await fetch(`/op/patch`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ space: spaceSlug, section: sectionSlug, path, tags }),
      });
    }

    function createTagEl(tag: string) {
      const span = document.createElement("span");
      span.className = "tag";
      span.dataset.tag = tag;
      span.textContent = tag;
      const removeBtn = document.createElement("button");
      removeBtn.className = "tag-remove";
      removeBtn.setAttribute("aria-label", `Remove tag ${tag}`);
      removeBtn.innerHTML = "&times;";
      removeBtn.onclick = async () => {
        span.remove();
        await saveTags(getCurrentTags());
      };
      span.appendChild(removeBtn);
      return span;
    }

    tagsEl.addEventListener("click", async (e) => {
      const target = e.target as HTMLElement | null;
      const removeBtn = target?.closest(".tag-remove");
      if (!removeBtn) return;
      e.preventDefault();
      removeBtn.closest(".tag")?.remove();
      await saveTags(getCurrentTags());
    });

    addBtn?.addEventListener("click", () => {
      if (tagsEl.querySelector(".tag-input")) return;
      const input = document.createElement("input");
      input.type = "text";
      input.className = "tag-input";
      input.placeholder = "tag…";
      tagsEl.insertBefore(input, addBtn);
      input.focus();

      async function commit() {
        const val = input.value.trim().toLowerCase().replace(/[^a-z0-9-]/g, "-").replace(/-+/g, "-");
        input.remove();
        if (!val || getCurrentTags().includes(val)) return;
        tagsEl!.insertBefore(createTagEl(val), addBtn);
        await saveTags(getCurrentTags());
      }

      input.addEventListener("keydown", (e) => {
        if (e.key === "Enter") { e.preventDefault(); commit(); }
        if (e.key === "Escape") input.remove();
      });
      input.addEventListener("blur", commit);
    });
  }
</script>

<script>
  // Vanilla JS: text selection → comment button + rich context capture
  const btn = document.createElement("button");
  btn.className = "selection-comment-btn";
  btn.setAttribute("aria-label", "Add comment");
  btn.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`;
  btn.style.display = "none";
  document.body.appendChild(btn);

  let currentDetail: any = null;

  function getSectionPath(node: Node): string {
    const docContent = (node as HTMLElement).closest?.(".sw-doc-content")
      || (node.parentElement?.closest(".sw-doc-content"));
    if (!docContent) return "";
    const headings = Array.from(docContent.querySelectorAll("h1, h2, h3, h4, h5, h6"));
    const selectionTop = (node as HTMLElement).getBoundingClientRect?.()?.top
      ?? node.parentElement?.getBoundingClientRect()?.top ?? 0;
    const above = headings.filter(h => h.getBoundingClientRect().top < selectionTop);
    if (above.length === 0) return "";
    const levels: Map<number, string> = new Map();
    for (const h of above) {
      const level = parseInt(h.tagName[1]);
      const text = h.textContent?.trim() || "";
      levels.set(level, text);
      for (const [k] of levels) {
        if (k > level) levels.delete(k);
      }
    }
    return Array.from(levels.entries()).sort(([a], [b]) => a - b).map(([, text]) => text).join(" > ");
  }

  function getContext(range: Range): string {
    const container = range.commonAncestorContainer;
    const block = container.nodeType === Node.TEXT_NODE
      ? container.parentElement
      : container as HTMLElement;
    if (!block) return "";
    let contextEl: HTMLElement | null = block;
    while (contextEl && !["P", "LI", "TD", "PRE", "BLOCKQUOTE", "H1", "H2", "H3", "H4", "H5", "H6"].includes(contextEl.tagName)) {
      contextEl = contextEl.parentElement;
      if (contextEl?.classList.contains("sw-doc-content")) { contextEl = block; break; }
    }
    if (!contextEl) return "";
    const fullText = contextEl.textContent?.trim() || "";
    return fullText.slice(0, 300);
  }

  document.addEventListener("mouseup", () => {
    setTimeout(() => {
      const sel = window.getSelection();
      if (!sel || sel.isCollapsed || !sel.toString().trim()) {
        btn.style.display = "none";
        return;
      }
      const docContent = sel.anchorNode?.parentElement?.closest(".sw-doc-content");
      if (!docContent) {
        btn.style.display = "none";
        return;
      }
      const range = sel.getRangeAt(0);
      const rect = range.getBoundingClientRect();
      const anchorText = sel.toString().trim().slice(0, 200);
      const anchorSection = getSectionPath(sel.anchorNode!);
      const anchorContext = getContext(range);
      currentDetail = { anchorText, anchorSection, anchorContext };
      btn.style.display = "flex";
      btn.style.position = "fixed";
      btn.style.left = `${rect.right + 6}px`;
      btn.style.top = `${rect.top - 2}px`;
    }, 10);
  });

  document.addEventListener("mousedown", (e) => {
    if (!(e.target as HTMLElement).closest(".selection-comment-btn")) {
      btn.style.display = "none";
    }
  });
  document.addEventListener("scroll", () => { btn.style.display = "none"; }, { passive: true });

  btn.addEventListener("click", () => {
    btn.style.display = "none";
    window.getSelection()?.removeAllRanges();
    document.dispatchEvent(new CustomEvent("sideways:inline-comment", { detail: currentDetail }));
  });
</script>
<script define:vars={{ rawContent, API_URL, spaceSlug, sectionSlug, path: doc.path, pdfThemesJson: JSON.stringify(themes.map(t => ({ id: t.id, name: t.name, tokens: t.tokens }))) }}>
  // Editor mode toggle
  const editBtn = document.getElementById("edit-toggle");
  const docView = document.getElementById("doc-view");
  const docEditor = document.getElementById("doc-editor");
  const textarea = document.getElementById("editor-textarea");
  const preview = document.getElementById("editor-preview-content");
  const saveBtn = document.getElementById("editor-save");
  const cancelBtn = document.getElementById("editor-cancel");
  const copyBtn = document.getElementById("copy-markdown");

  if (editBtn && docView && docEditor && textarea) {
    let previewTimer = null;

    const sidebar = document.getElementById("sidebar");
    const docPage = document.querySelector(".doc-page");
    const previewPane = document.querySelector(".editor-preview");

    function getTopmostVisibleHeading() {
      const headings = docView.querySelectorAll("h1, h2, h3, h4, h5, h6");
      const headerOffset = parseInt(getComputedStyle(document.documentElement).getPropertyValue("--sw-header-height")) || 56;
      for (const h of headings) {
        const rect = h.getBoundingClientRect();
        if (rect.top >= headerOffset - 10) {
          return h.textContent?.trim() || null;
        }
      }
      if (headings.length) return headings[headings.length - 1].textContent?.trim() || null;
      return null;
    }

    function findHeadingLine(headingText) {
      const lines = textarea.value.split("\n");
      for (let i = 0; i < lines.length; i++) {
        const match = lines[i].match(/^#{1,6}\s+(.+)/);
        if (match && match[1].trim() === headingText) return i;
      }
      return -1;
    }

    function scrollTextareaToLine(lineNum) {
      const lineHeight = parseFloat(getComputedStyle(textarea).lineHeight) || 24;
      textarea.scrollTop = lineNum * lineHeight;
    }

    function getHeadingNearCursor() {
      const pos = textarea.selectionStart;
      const textBefore = textarea.value.slice(0, pos);
      const lines = textBefore.split("\n");
      for (let i = lines.length - 1; i >= 0; i--) {
        const match = lines[i].match(/^#{1,6}\s+(.+)/);
        if (match) return match[1].trim();
      }
      return null;
    }

    function scrollPreviewToHeading(headingText) {
      if (!previewPane) return;
      const headings = previewPane.querySelectorAll("h1, h2, h3, h4, h5, h6");
      for (const h of headings) {
        if (h.textContent?.trim() === headingText) {
          previewPane.scrollTop = h.offsetTop - previewPane.offsetTop;
          return;
        }
      }
    }

    function scrollViewToHeading(headingText) {
      const headings = docView.querySelectorAll("h1, h2, h3, h4, h5, h6");
      for (const h of headings) {
        if (h.textContent?.trim() === headingText) {
          h.scrollIntoView({ block: "start", behavior: "auto" });
          return;
        }
      }
    }

    editBtn.addEventListener("click", () => {
      const visibleHeading = getTopmostVisibleHeading();
      textarea.value = rawContent;
      docView.style.display = "none";
      docEditor.style.display = "flex";
      editBtn.style.display = "none";
      if (sidebar) sidebar.style.display = "none";
      if (docPage) docPage.style.maxWidth = "none";
      document.body.style.overflow = "hidden";
      window.scrollTo(0, 0);

      requestAnimationFrame(() => {
        if (visibleHeading) {
          const line = findHeadingLine(visibleHeading);
          if (line >= 0) {
            scrollTextareaToLine(line);
            const lines = textarea.value.split("\n");
            const pos = lines.slice(0, line).reduce((sum, l) => sum + l.length + 1, 0);
            textarea.setSelectionRange(pos, pos);
          }
        } else {
          textarea.setSelectionRange(0, 0);
          textarea.scrollTop = 0;
        }
        textarea.focus();
      });

      updatePreview().then(() => {
        if (visibleHeading) {
          requestAnimationFrame(() => scrollPreviewToHeading(visibleHeading));
        }
      });
    });

    cancelBtn?.addEventListener("click", () => {
      const headingNearCursor = getHeadingNearCursor();
      docEditor.style.display = "none";
      docView.style.display = "block";
      editBtn.style.display = "";
      if (sidebar) sidebar.style.display = "";
      if (docPage) docPage.style.maxWidth = "";
      document.body.style.overflow = "";
      requestAnimationFrame(() => {
        if (headingNearCursor) scrollViewToHeading(headingNearCursor);
      });
    });

    let syncTimer = null;
    function syncPreviewToCursor() {
      clearTimeout(syncTimer);
      syncTimer = setTimeout(() => {
        const heading = getHeadingNearCursor();
        if (heading) scrollPreviewToHeading(heading);
      }, 150);
    }

    textarea.addEventListener("click", syncPreviewToCursor);
    textarea.addEventListener("keyup", (e) => {
      if (["ArrowUp", "ArrowDown", "PageUp", "PageDown", "Home", "End"].includes(e.key)) {
        syncPreviewToCursor();
      }
    });

    textarea.addEventListener("input", () => {
      clearTimeout(previewTimer);
      previewTimer = setTimeout(() => updatePreview(), 300);
    });

    async function updatePreview() {
      try {
        const res = await fetch(`/op/render`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ space: spaceSlug, section: sectionSlug, path, content: textarea.value }),
        });
        if (!res.ok) {
          preview.innerHTML = `<pre style="white-space: pre-wrap;">${textarea.value.replace(/</g, "&lt;")}</pre>`;
          return;
        }
        const data = await res.json();
        preview.innerHTML = data.html || "";
        // Anything that decorates rendered markdown client-side (mermaid) has
        // to run again over the freshly replaced pane.
        document.dispatchEvent(new CustomEvent("sideways:preview-rendered"));
      } catch {
        preview.innerHTML = `<pre style="white-space: pre-wrap;">${textarea.value.replace(/</g, "&lt;")}</pre>`;
      }
    }

    saveBtn?.addEventListener("click", async () => {
      saveBtn.disabled = true;
      saveBtn.textContent = "Saving...";
      try {
        const res = await fetch(`/op/save`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ space: spaceSlug, section: sectionSlug, path, content: textarea.value }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert("Failed to save. You may need to sign in.");
          saveBtn.disabled = false;
          saveBtn.textContent = "Save";
        }
      } catch {
        alert("Connection error.");
        saveBtn.disabled = false;
        saveBtn.textContent = "Save";
      }
    });

    if (new URLSearchParams(window.location.search).has("edit")) {
      editBtn.click();
      if (!rawContent.trim()) {
        textarea.value = "# ";
        requestAnimationFrame(() => {
          textarea.setSelectionRange(textarea.value.length, textarea.value.length);
          textarea.focus();
        });
      }
      history.replaceState(null, "", window.location.pathname);
    }
  }

  copyBtn?.addEventListener("click", () => {
    navigator.clipboard.writeText(rawContent).then(() => {
      const span = copyBtn.querySelector("span");
      if (span) {
        span.textContent = "Copied!";
        setTimeout(() => { span.textContent = "Copy markdown"; }, 2000);
      }
    });
  });

  // Actions menu
  const actionsToggle = document.getElementById("actions-toggle");
  const actionsDropdown = document.getElementById("actions-dropdown");
  actionsToggle?.addEventListener("click", (e) => {
    e.stopPropagation();
    const visible = actionsDropdown.style.display !== "none";
    actionsDropdown.style.display = visible ? "none" : "block";
  });
  document.addEventListener("click", () => {
    if (actionsDropdown) actionsDropdown.style.display = "none";
  });

  // Rename — change the path's basename. Title goes through patch too.
  document.getElementById("action-rename")?.addEventListener("click", async () => {
    const currentTitle = document.querySelector("h1")?.textContent || "";
    const newTitle = prompt("New title:", currentTitle);
    if (!newTitle) return;

    // Derive a new path by replacing the basename with a slugified title.
    // Preserve directory prefix and the filename ext (.md).
    const newBase = newTitle.toLowerCase().replace(/[^a-z0-9-]/g, "-").replace(/-+/g, "-").replace(/^-|-$/g, "");
    const dirPart = path.includes("/") ? path.slice(0, path.lastIndexOf("/") + 1) : "";
    // If renaming an `index.md`, keep it as `index.md` (the directory name doesn't change here).
    const isIndex = path.endsWith("/index.md") || path === "index.md";
    const targetPath = isIndex ? path : `${dirPart}${newBase}.md`;

    const res = await fetch(`/op/patch`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ space: spaceSlug, section: sectionSlug, path, title: newTitle, targetPath }),
    });

    if (res.ok) {
      const updated = await res.json();
      window.location.href = updated.url;
    } else if (res.status === 409) {
      alert("A document with that path already exists.");
    } else {
      alert("Rename failed.");
    }
  });

  // Duplicate
  document.getElementById("action-duplicate")?.addEventListener("click", async () => {
    const res = await fetch(`/op/duplicate`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ space: spaceSlug, section: sectionSlug, path }),
    });
    if (res.ok) {
      const newDoc = await res.json();
      window.location.href = newDoc.url;
    } else {
      alert("Duplicate failed.");
    }
  });

  // Download PDF modal
  const pdfOverlay = document.getElementById("pdf-overlay");
  const pdfThemeSelect = document.getElementById("pdf-theme");
  const pdfCover = document.getElementById("pdf-cover");
  const pdfToc = document.getElementById("pdf-toc");

  function openPdfModal() { updatePdfDefaults(); pdfOverlay.style.display = "flex"; }
  function closePdfModal() { pdfOverlay.style.display = "none"; }
  function updatePdfDefaults() {
    if (!pdfThemeSelect || !pdfCover || !pdfToc) return;
    const themeId = pdfThemeSelect.value;
    const allThemes = JSON.parse(pdfThemesJson);
    const theme = allThemes.find((t) => t.id === themeId);
    if (theme?.tokens?.print) {
      pdfCover.checked = theme.tokens.print.defaultTitlePage !== false;
      pdfToc.checked = theme.tokens.print.defaultToc !== false;
    } else {
      pdfCover.checked = true; pdfToc.checked = true;
    }
  }

  document.getElementById("action-pdf")?.addEventListener("click", () => {
    if (actionsDropdown) actionsDropdown.style.display = "none";
    openPdfModal();
  });
  document.getElementById("pdf-modal-close")?.addEventListener("click", closePdfModal);
  pdfOverlay?.addEventListener("click", (e) => { if (e.target === pdfOverlay) closePdfModal(); });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && pdfOverlay?.style.display !== "none") closePdfModal();
  });
  pdfThemeSelect?.addEventListener("change", updatePdfDefaults);

  document.getElementById("pdf-btn-download")?.addEventListener("click", () => {
    const params = new URLSearchParams();
    params.set("space", spaceSlug);
    params.set("section", sectionSlug);
    params.set("path", path);
    if (pdfThemeSelect?.value) params.set("theme", pdfThemeSelect.value);
    if (pdfCover && !pdfCover.checked) params.set("title-page", "false");
    if (pdfToc && !pdfToc.checked) params.set("toc", "false");

    const a = document.createElement("a");
    a.href = `/op/pdf?${params.toString()}`;
    a.download = `${path.replace(/\.md$/, "").split("/").pop()}.pdf`;
    a.click();
    closePdfModal();
  });

  // Move to section
  const moveBtn = document.getElementById("action-move");
  const moveSubmenu = document.getElementById("move-submenu");
  moveBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    const visible = moveSubmenu.style.display !== "none";
    moveSubmenu.style.display = visible ? "none" : "block";
  });

  document.querySelectorAll(".submenu-item").forEach((item) => {
    item.addEventListener("click", async (e) => {
      e.stopPropagation();
      const targetSection = e.target.dataset.targetSection;
      if (!targetSection || targetSection === sectionSlug) return;

      const res = await fetch(`/op/patch`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ space: spaceSlug, section: sectionSlug, path, targetSection }),
      });

      if (res.ok) {
        const updated = await res.json();
        window.location.href = updated.url;
      } else {
        alert("Move failed.");
      }
    });
  });

  // Delete
  document.getElementById("action-delete")?.addEventListener("click", async () => {
    if (!confirm("Delete this document? This cannot be undone.")) return;
    const res = await fetch(`/op/delete`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ space: spaceSlug, section: sectionSlug, path }),
    });
    if (res.ok) {
      window.location.href = `/s/${spaceSlug}`;
    } else {
      alert("Delete failed.");
    }
  });
</script>
)}
