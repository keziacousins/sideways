---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";

import { apiFetch } from "../../lib/api.ts";

const { space: spaceSlug } = Astro.params;
const { accessToken } = Astro.locals;

let space: { name: string; slug: string; description: string | null } | null = null;
let documents: { slug: string; title: string; tags: string[] }[] = [];

try {
  const spaceRes = await apiFetch(`/api/spaces/${spaceSlug}`, accessToken);
  if (spaceRes.ok) {
    space = await spaceRes.json();
    const docsRes = await apiFetch(`/api/documents?space=${spaceSlug}`, accessToken);
    documents = await docsRes.json();
  }
} catch {
  // API not available
}

const navItems = documents.map((doc) => ({
  slug: doc.slug,
  title: doc.title,
  type: "doc" as const,
}));
---

<BaseLayout title={space?.name ?? "Not Found"} sidebar={!!space}>
  <Fragment slot="sidebar">
    {space && (
      <Sidebar
        spaceSlug={spaceSlug!}
        spaceName={space.name}
        items={navItems}
      />
    )}
  </Fragment>

  {space ? (
    <div class="space-landing">
      <div class="space-header animate-in">
        <h1>{space.name}</h1>
        {space.description && <p class="space-desc">{space.description}</p>}
      </div>

      <div class="doc-grid">
        {documents.length === 0 ? (
          <p class="empty-state">No documents in this space yet.</p>
        ) : (
          documents.map((doc, i) => (
            <a
              href={`/s/${spaceSlug}/${doc.slug}`}
              class="doc-card animate-in"
              style={`animation-delay: ${(i + 1) * 60}ms`}
            >
              <div class="doc-card-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <polyline points="14 2 14 8 20 8" />
                  <line x1="16" y1="13" x2="8" y2="13" />
                  <line x1="16" y1="17" x2="8" y2="17" />
                </svg>
              </div>
              <span class="doc-card-title">{doc.title}</span>
              {doc.tags?.length > 0 && (
                <div class="doc-tags">
                  {doc.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
            </a>
          ))
        )}
      </div>
    </div>
  ) : (
    <div class="not-found">
      <h1>Space not found</h1>
      <a href="/">Back to spaces</a>
    </div>
  )}
</BaseLayout>

<style>
  .space-landing {
    max-width: 640px;
  }

  .space-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--sw-border);
    margin-bottom: 2rem;
  }

  .space-header h1 {
    font-family: var(--sw-font-display);
    font-size: var(--sw-text-3xl);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
  }

  .space-desc {
    color: var(--sw-text-tertiary);
    font-size: var(--sw-text-base);
  }

  .doc-grid {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .doc-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: var(--sw-radius-md);
    text-decoration: none;
    color: inherit;
    transition: background var(--sw-duration-fast) var(--sw-ease);
  }

  .doc-card:hover {
    background: var(--sw-ink-light);
  }

  .doc-card-icon {
    color: var(--sw-text-ghost);
    flex-shrink: 0;
  }

  .doc-card-title {
    font-size: var(--sw-text-base);
    color: var(--sw-text-primary);
    flex: 1;
  }

  .doc-tags {
    display: flex;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  .tag {
    font-size: var(--sw-text-xs);
    padding: 0.15em 0.5em;
    background: var(--sw-ink-lighter);
    border-radius: var(--sw-radius-sm);
    color: var(--sw-text-tertiary);
  }

  .empty-state {
    padding: 3rem 0;
    text-align: center;
    color: var(--sw-text-ghost);
  }

  .not-found {
    padding: 4rem 0;
    text-align: center;
  }

  .not-found h1 {
    font-family: var(--sw-font-display);
    margin-bottom: 1rem;
  }
</style>
