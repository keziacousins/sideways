{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@sideways/types": ["./shared/types/src"],
      "@sideways/markdown": ["./shared/markdown/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
