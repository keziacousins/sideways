---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Sidebar from "../../../components/Sidebar.astro";
import Comments from "../../../components/Comments.tsx";
import "../../../styles/document.css";
import "../../../styles/comments.css";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:4100";
const { space: spaceSlug, slug } = Astro.params;

const accessToken = await Astro.session?.get("access_token") || null;
const refreshToken = await Astro.session?.get("refresh_token") || null;

let space: { name: string; slug: string } | null = null;
let doc: {
  title: string;
  html: string;
  tags: string[];
  updatedAt: string;
  version: number;
  versionCount: number;
  versionDate: string;
} | null = null;
let documents: { slug: string; title: string; tags: string[] }[] = [];

try {
  const spaceRes = await fetch(`${API_URL}/api/spaces/${spaceSlug}`);
  if (spaceRes.ok) {
    space = await spaceRes.json();

    const [docRes, docsRes] = await Promise.all([
      fetch(`${API_URL}/api/documents/${spaceSlug}/${slug}/render`),
      fetch(`${API_URL}/api/documents?space=${spaceSlug}`),
    ]);

    if (docRes.ok) doc = await docRes.json();
    if (docsRes.ok) documents = await docsRes.json();
  }
} catch {
  // API not available
}

const html = doc?.html ?? "";
const navItems = documents.map((d) => ({
  slug: d.slug,
  title: d.title,
  type: "doc" as const,
}));
---

<BaseLayout title={doc?.title ?? "Not Found"} sidebar={!!space}>
  <Fragment slot="sidebar">
    {space && (
      <Sidebar
        spaceSlug={spaceSlug!}
        spaceName={space.name}
        items={navItems}
        activeSlug={slug}
      />
    )}
  </Fragment>

  {doc ? (
    <div class="doc-page">
      <nav class="breadcrumbs">
        <a href="/">Spaces</a>
        <span class="breadcrumb-sep">/</span>
        <a href={`/s/${spaceSlug}`}>{space?.name}</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">{doc.title}</span>
      </nav>

      <div class="doc-toolbar">
        <div class="doc-toolbar-left">
          {doc.tags?.length > 0 && (
            <div class="doc-tags">
              {doc.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
          <span class="doc-version" title={`Last updated ${new Date(doc.versionDate).toLocaleString()}`}>
            v{doc.version}
            {doc.versionCount > 1 && (
              <span class="version-count">· {doc.versionCount} versions</span>
            )}
            <span class="version-date">· {new Date(doc.versionDate).toLocaleDateString()}</span>
          </span>
        </div>
        <div class="doc-toolbar-right">
          <button class="toolbar-btn" title="Copy as markdown">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
            <span>Copy markdown</span>
          </button>
          <Comments
            client:load
            spaceSlug={spaceSlug!}
            docSlug={slug!}
            apiUrl={API_URL}
            accessToken={accessToken}
            refreshToken={refreshToken}
          />
        </div>
      </div>

      <article class="sw-doc-content">
        <Fragment set:html={html} />
      </article>
    </div>
  ) : (
    <div class="not-found">
      <h1>Document not found</h1>
      <a href={`/s/${spaceSlug}`}>Back to {space?.name || "space"}</a>
    </div>
  )}
</BaseLayout>

<style>
  .doc-page {
    max-width: var(--sw-content-max);
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--sw-text-sm);
    color: var(--sw-text-tertiary);
    margin-bottom: 1.5rem;
  }

  .breadcrumbs a {
    color: var(--sw-text-tertiary);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--sw-accent);
  }

  .breadcrumb-sep {
    color: var(--sw-text-ghost);
  }

  .breadcrumb-current {
    color: var(--sw-text-secondary);
  }

  .doc-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--sw-border);
  }

  .doc-toolbar-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .doc-toolbar-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .toolbar-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0;
    background: none;
    border: none;
    color: var(--sw-text-secondary);
    font-size: var(--sw-text-sm);
    font-family: var(--sw-font-body);
    cursor: pointer;
    transition: color var(--sw-duration-fast) var(--sw-ease);
  }

  .toolbar-btn:hover {
    color: var(--sw-text-primary);
  }

  .doc-tags {
    display: flex;
    gap: 0.35rem;
  }

  .tag {
    font-size: var(--sw-text-xs);
    padding: 0.2em 0.55em;
    background: var(--sw-ink-surface);
    border-radius: var(--sw-radius-sm);
    color: var(--sw-text-secondary);
  }

  .doc-version {
    font-size: var(--sw-text-xs);
    color: var(--sw-text-tertiary);
    cursor: default;
  }

  .version-count,
  .version-date {
    color: var(--sw-text-ghost);
  }

  .not-found {
    padding: 4rem 0;
    text-align: center;
  }

  .not-found h1 {
    font-family: var(--sw-font-display);
    margin-bottom: 1rem;
  }
</style>

{doc && (
<script>
  // Vanilla JS: text selection → comment button + rich context capture
  const btn = document.createElement("button");
  btn.className = "selection-comment-btn";
  btn.setAttribute("aria-label", "Add comment");
  btn.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`;
  btn.style.display = "none";
  document.body.appendChild(btn);

  let currentDetail: any = null;

  /** Walk up from a node to find the heading hierarchy */
  function getSectionPath(node: Node): string {
    const docContent = (node as HTMLElement).closest?.(".sw-doc-content")
      || (node.parentElement?.closest(".sw-doc-content"));
    if (!docContent) return "";

    // Find all headings before the selection point
    const headings = Array.from(docContent.querySelectorAll("h1, h2, h3, h4, h5, h6"));
    const selectionTop = (node as HTMLElement).getBoundingClientRect?.()?.top
      ?? node.parentElement?.getBoundingClientRect()?.top ?? 0;

    // Filter headings that are above the selection
    const above = headings.filter(h => h.getBoundingClientRect().top < selectionTop);
    if (above.length === 0) return "";

    // Build hierarchy: keep the most recent heading at each level
    const levels: Map<number, string> = new Map();
    for (const h of above) {
      const level = parseInt(h.tagName[1]);
      const text = h.textContent?.trim() || "";
      levels.set(level, text);
      // Clear deeper levels when a shallower heading appears
      for (const [k] of levels) {
        if (k > level) levels.delete(k);
      }
    }

    // Build path from shallowest to deepest
    return Array.from(levels.entries())
      .sort(([a], [b]) => a - b)
      .map(([, text]) => text)
      .join(" > ");
  }

  /** Get surrounding text context around the selection */
  function getContext(range: Range): string {
    const container = range.commonAncestorContainer;
    const block = container.nodeType === Node.TEXT_NODE
      ? container.parentElement
      : container as HTMLElement;
    if (!block) return "";

    // Walk up to find a meaningful block (p, li, td, pre, blockquote)
    let contextEl: HTMLElement | null = block;
    while (contextEl && !["P", "LI", "TD", "PRE", "BLOCKQUOTE", "H1", "H2", "H3", "H4", "H5", "H6"].includes(contextEl.tagName)) {
      contextEl = contextEl.parentElement;
      if (contextEl?.classList.contains("sw-doc-content")) { contextEl = block; break; }
    }
    if (!contextEl) return "";

    const fullText = contextEl.textContent?.trim() || "";
    return fullText.slice(0, 300);
  }

  document.addEventListener("mouseup", () => {
    setTimeout(() => {
      const sel = window.getSelection();
      if (!sel || sel.isCollapsed || !sel.toString().trim()) {
        btn.style.display = "none";
        return;
      }

      const docContent = sel.anchorNode?.parentElement?.closest(".sw-doc-content");
      if (!docContent) {
        btn.style.display = "none";
        return;
      }

      const range = sel.getRangeAt(0);
      const rect = range.getBoundingClientRect();
      const anchorText = sel.toString().trim().slice(0, 200);
      const anchorSection = getSectionPath(sel.anchorNode!);
      const anchorContext = getContext(range);

      currentDetail = { anchorText, anchorSection, anchorContext };

      btn.style.display = "flex";
      btn.style.position = "fixed";
      btn.style.left = `${rect.right + 6}px`;
      btn.style.top = `${rect.top - 2}px`;
    }, 10);
  });

  document.addEventListener("mousedown", (e) => {
    if (!(e.target as HTMLElement).closest(".selection-comment-btn")) {
      btn.style.display = "none";
    }
  });

  document.addEventListener("scroll", () => {
    btn.style.display = "none";
  }, { passive: true });

  btn.addEventListener("click", () => {
    btn.style.display = "none";
    window.getSelection()?.removeAllRanges();
    document.dispatchEvent(
      new CustomEvent("sideways:inline-comment", {
        detail: currentDetail,
      })
    );
  });
</script>
)}
