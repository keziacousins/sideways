---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Sidebar from "../../../components/Sidebar.astro";
import Comments from "../../../components/Comments.tsx";
import "../../../styles/document.css";
import "../../../styles/comments.css";

import { apiFetch } from "../../../lib/api.ts";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:4100";
const { space: spaceSlug, slug } = Astro.params;
const { accessToken } = Astro.locals;
const refreshToken = await Astro.session?.get("refresh_token") || null;

let space: { name: string; slug: string; canWrite?: boolean } | null = null;
let doc: {
  title: string;
  html: string;
  tags: string[];
  updatedAt: string;
  version: number;
  versionCount: number;
  versionDate: string;
} | null = null;
let documents: { slug: string; title: string; tags: string[] }[] = [];
let rawContent = "";

try {
  const spaceRes = await apiFetch(`/api/spaces/${spaceSlug}`, accessToken);
  if (spaceRes.ok) {
    space = await spaceRes.json();

    const [docRes, rawRes, docsRes] = await Promise.all([
      apiFetch(`/api/documents/${spaceSlug}/${slug}/render`, accessToken),
      apiFetch(`/api/documents/${spaceSlug}/${slug}`, accessToken),
      apiFetch(`/api/documents?space=${spaceSlug}`, accessToken),
    ]);

    if (docRes.ok) doc = await docRes.json();
    if (docsRes.ok) documents = await docsRes.json();
    if (rawRes.ok) {
      const rawDoc = await rawRes.json();
      rawContent = rawDoc.content || "";
    }
  }
} catch {
  // API not available
}

const html = doc?.html ?? "";
const navItems = documents.map((d) => ({
  slug: d.slug,
  title: d.title,
  type: "doc" as const,
}));
---

<BaseLayout title={doc?.title ?? "Not Found"} sidebar={!!space}>
  <Fragment slot="sidebar">
    {space && (
      <Sidebar
        spaceSlug={spaceSlug!}
        spaceName={space.name}
        items={navItems}
        activeSlug={slug}
      />
    )}
  </Fragment>

  {doc ? (
    <div class="doc-page">
      <nav class="breadcrumbs">
        <a href="/">Spaces</a>
        <span class="breadcrumb-sep">/</span>
        <a href={`/s/${spaceSlug}`}>{space?.name}</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">{doc.title}</span>
      </nav>

      {doc.tags?.length > 0 && (
        <div class="doc-tags">
          {doc.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}

      <div class="doc-toolbar">
        <div class="doc-toolbar-left">
          <button class="doc-version" id="version-info" title={`Last updated ${new Date(doc.versionDate).toLocaleString()}`}>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            v{doc.version} · {doc.versionCount} version{doc.versionCount !== 1 ? 's' : ''} · {new Date(doc.versionDate).toLocaleDateString()}
          </button>
        </div>
        <div class="doc-toolbar-right">
          {space?.canWrite && (
            <button class="toolbar-btn" id="edit-toggle" title="Edit">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
              </svg>
            </button>
          )}
          <button class="toolbar-btn" id="copy-markdown" title="Copy as markdown">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
          </button>
          <Comments
            client:load
            spaceSlug={spaceSlug!}
            docSlug={slug!}
            apiUrl={API_URL}
            accessToken={accessToken}
            refreshToken={refreshToken}
          />
          <div class="doc-actions-menu" id="doc-actions-menu">
            <button class="toolbar-btn" id="actions-toggle" title="More actions">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="5" r="1" /><circle cx="12" cy="12" r="1" /><circle cx="12" cy="19" r="1" />
              </svg>
            </button>
            <div class="actions-dropdown" id="actions-dropdown" style="display: none;">
              <button class="action-item" id="action-pdf">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                Download PDF
              </button>
              {space?.canWrite && (
                <>
                  <div class="action-divider"></div>
                  <button class="action-item" id="action-rename">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                    Rename
                  </button>
                  <button class="action-item" id="action-duplicate">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    Duplicate
                  </button>
                  <button class="action-item action-danger" id="action-delete">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-2 14H7L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                    Delete
                  </button>
                </>
              )}
            </div>
          </div>
        </div>
      </div>

      <article class="sw-doc-content" id="doc-view">
        <Fragment set:html={html} />
      </article>

      <div class="doc-editor" id="doc-editor" style="display: none;">
        <div class="editor-panes">
          <div class="editor-input">
            <textarea id="editor-textarea" spellcheck="true"></textarea>
          </div>
          <div class="editor-preview">
            <div class="sw-doc-content" id="editor-preview-content"></div>
          </div>
        </div>
        <div class="editor-floating-bar">
          <button type="button" class="editor-cancel" id="editor-cancel">Cancel</button>
          <button type="button" class="editor-save" id="editor-save">Save</button>
        </div>
      </div>
    </div>
  ) : (
    <div class="not-found">
      <h1>Document not found</h1>
      <a href={`/s/${spaceSlug}`}>Back to {space?.name || "space"}</a>
    </div>
  )}
</BaseLayout>

<style>
  .doc-page {
    max-width: var(--sw-content-max);
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--sw-text-sm);
    color: var(--sw-text-tertiary);
    margin-bottom: 1.5rem;
  }

  .breadcrumbs a {
    color: var(--sw-text-tertiary);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--sw-accent);
  }

  .breadcrumb-sep {
    color: var(--sw-text-ghost);
  }

  .breadcrumb-current {
    color: var(--sw-text-secondary);
  }

  .doc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .tag {
    font-size: var(--sw-text-xs);
    padding: 0.15em 0.5em;
    background: var(--sw-ink-surface);
    border-radius: var(--sw-radius-sm);
    color: var(--sw-text-secondary);
  }

  .doc-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--sw-border);
    position: sticky;
    top: var(--sw-header-height);
    background: var(--sw-ink-deep);
    z-index: 10;
    padding-top: 0.5rem;
    margin-top: -0.5rem;
  }

  .doc-toolbar-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .toolbar-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    background: none;
    border: none;
    border-radius: var(--sw-radius-sm);
    color: var(--sw-text-tertiary);
    cursor: pointer;
    transition: all var(--sw-duration-fast) var(--sw-ease);
  }

  .toolbar-btn:hover {
    color: var(--sw-text-primary);
    background: var(--sw-ink-lighter);
  }

  /* ── Actions Menu ────────────────────── */
  .doc-actions-menu {
    position: relative;
  }

  .actions-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 0.35rem;
    background: var(--sw-ink);
    border: 1px solid var(--sw-border-strong);
    border-radius: var(--sw-radius-md);
    box-shadow: var(--sw-shadow-lg);
    min-width: 160px;
    z-index: 50;
    padding: 0.25rem;
  }

  .action-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.45rem 0.65rem;
    background: none;
    border: none;
    border-radius: var(--sw-radius-sm);
    color: var(--sw-text-secondary);
    font-family: var(--sw-font-body);
    font-size: var(--sw-text-sm);
    cursor: pointer;
    text-align: left;
  }

  .action-item:hover {
    background: var(--sw-ink-light);
    color: var(--sw-text-primary);
  }

  .action-item.action-danger:hover {
    background: rgba(248, 113, 113, 0.08);
    color: var(--sw-error);
  }

  .doc-toolbar-left {
    display: flex;
    align-items: center;
  }

  .doc-version {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.5rem;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--sw-radius-sm);
    color: var(--sw-text-secondary);
    font-size: var(--sw-text-xs);
    font-family: var(--sw-font-body);
    cursor: pointer;
    transition: all var(--sw-duration-fast) var(--sw-ease);
  }

  .doc-version:hover {
    color: var(--sw-text-primary);
    border-color: var(--sw-border);
    background: var(--sw-ink-light);
  }

  .action-divider {
    height: 1px;
    background: var(--sw-border);
    margin: 0.2rem 0.4rem;
  }

  /* ── Mobile: hide Edit/Copy, keep Comments + kebab ── */
  @media (max-width: 600px) {
    #edit-toggle,
    #copy-markdown,
    .doc-version {
      display: none;
    }
  }

  /* ── Editor ──────────────────────────── */
  .doc-editor {
    display: flex;
    flex-direction: column;
    /* Fill from current position to bottom of viewport, minus floating bar space */
    height: calc(100vh - var(--sw-header-height) - var(--sw-page-pad) - 5rem);
    min-height: 300px;
    position: relative;
    overflow: hidden;
  }

  .editor-panes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--sw-border);
    border: 1px solid var(--sw-border);
    border-radius: var(--sw-radius-md);
    overflow: hidden;
    flex: 1;
    min-height: 0;
  }

  .editor-input {
    background: var(--sw-ink-deepest);
    overflow: hidden;
  }

  .editor-input textarea {
    width: 100%;
    height: 100%;
    padding: 1.25rem;
    background: transparent;
    border: none;
    color: var(--sw-text-primary);
    font-family: var(--sw-font-mono);
    font-size: var(--sw-text-sm);
    line-height: 1.7;
    resize: none;
    outline: none;
    tab-size: 2;
  }

  .editor-preview {
    background: var(--sw-ink);
    padding: 1.25rem;
    overflow-y: auto;
  }

  .editor-floating-bar {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--sw-ink);
    border: 1px solid var(--sw-border-strong);
    border-radius: var(--sw-radius-lg);
    box-shadow: var(--sw-shadow-lg);
    z-index: 50;
  }

  .editor-cancel {
    padding: 0.45rem 1rem;
    background: none;
    border: 1px solid var(--sw-border);
    border-radius: var(--sw-radius-md);
    color: var(--sw-text-secondary);
    font-family: var(--sw-font-body);
    font-size: var(--sw-text-sm);
    cursor: pointer;
  }

  .editor-cancel:hover {
    border-color: var(--sw-border-strong);
    color: var(--sw-text-primary);
  }

  .editor-save {
    padding: 0.45rem 1.25rem;
    background: var(--sw-accent);
    color: var(--sw-ink-deepest);
    border: none;
    border-radius: var(--sw-radius-md);
    font-family: var(--sw-font-body);
    font-size: var(--sw-text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .editor-save:hover {
    background: var(--sw-accent-strong);
  }

  .editor-save:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  @media (max-width: 800px) {
    .editor-panes {
      grid-template-columns: 1fr;
    }
    .editor-preview {
      display: none;
    }
  }

  .not-found {
    padding: 4rem 0;
    text-align: center;
  }

  .not-found h1 {
    font-family: var(--sw-font-display);
    margin-bottom: 1rem;
  }
</style>

{doc && (
<script>
  // Vanilla JS: text selection → comment button + rich context capture
  const btn = document.createElement("button");
  btn.className = "selection-comment-btn";
  btn.setAttribute("aria-label", "Add comment");
  btn.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`;
  btn.style.display = "none";
  document.body.appendChild(btn);

  let currentDetail: any = null;

  /** Walk up from a node to find the heading hierarchy */
  function getSectionPath(node: Node): string {
    const docContent = (node as HTMLElement).closest?.(".sw-doc-content")
      || (node.parentElement?.closest(".sw-doc-content"));
    if (!docContent) return "";

    // Find all headings before the selection point
    const headings = Array.from(docContent.querySelectorAll("h1, h2, h3, h4, h5, h6"));
    const selectionTop = (node as HTMLElement).getBoundingClientRect?.()?.top
      ?? node.parentElement?.getBoundingClientRect()?.top ?? 0;

    // Filter headings that are above the selection
    const above = headings.filter(h => h.getBoundingClientRect().top < selectionTop);
    if (above.length === 0) return "";

    // Build hierarchy: keep the most recent heading at each level
    const levels: Map<number, string> = new Map();
    for (const h of above) {
      const level = parseInt(h.tagName[1]);
      const text = h.textContent?.trim() || "";
      levels.set(level, text);
      // Clear deeper levels when a shallower heading appears
      for (const [k] of levels) {
        if (k > level) levels.delete(k);
      }
    }

    // Build path from shallowest to deepest
    return Array.from(levels.entries())
      .sort(([a], [b]) => a - b)
      .map(([, text]) => text)
      .join(" > ");
  }

  /** Get surrounding text context around the selection */
  function getContext(range: Range): string {
    const container = range.commonAncestorContainer;
    const block = container.nodeType === Node.TEXT_NODE
      ? container.parentElement
      : container as HTMLElement;
    if (!block) return "";

    // Walk up to find a meaningful block (p, li, td, pre, blockquote)
    let contextEl: HTMLElement | null = block;
    while (contextEl && !["P", "LI", "TD", "PRE", "BLOCKQUOTE", "H1", "H2", "H3", "H4", "H5", "H6"].includes(contextEl.tagName)) {
      contextEl = contextEl.parentElement;
      if (contextEl?.classList.contains("sw-doc-content")) { contextEl = block; break; }
    }
    if (!contextEl) return "";

    const fullText = contextEl.textContent?.trim() || "";
    return fullText.slice(0, 300);
  }

  document.addEventListener("mouseup", () => {
    setTimeout(() => {
      const sel = window.getSelection();
      if (!sel || sel.isCollapsed || !sel.toString().trim()) {
        btn.style.display = "none";
        return;
      }

      const docContent = sel.anchorNode?.parentElement?.closest(".sw-doc-content");
      if (!docContent) {
        btn.style.display = "none";
        return;
      }

      const range = sel.getRangeAt(0);
      const rect = range.getBoundingClientRect();
      const anchorText = sel.toString().trim().slice(0, 200);
      const anchorSection = getSectionPath(sel.anchorNode!);
      const anchorContext = getContext(range);

      currentDetail = { anchorText, anchorSection, anchorContext };

      btn.style.display = "flex";
      btn.style.position = "fixed";
      btn.style.left = `${rect.right + 6}px`;
      btn.style.top = `${rect.top - 2}px`;
    }, 10);
  });

  document.addEventListener("mousedown", (e) => {
    if (!(e.target as HTMLElement).closest(".selection-comment-btn")) {
      btn.style.display = "none";
    }
  });

  document.addEventListener("scroll", () => {
    btn.style.display = "none";
  }, { passive: true });

  btn.addEventListener("click", () => {
    btn.style.display = "none";
    window.getSelection()?.removeAllRanges();
    document.dispatchEvent(
      new CustomEvent("sideways:inline-comment", {
        detail: currentDetail,
      })
    );
  });
</script>
<script define:vars={{ rawContent, API_URL, spaceSlug, slug }}>
  // Editor mode toggle
  const editBtn = document.getElementById("edit-toggle");
  const docView = document.getElementById("doc-view");
  const docEditor = document.getElementById("doc-editor");
  const textarea = document.getElementById("editor-textarea");
  const preview = document.getElementById("editor-preview-content");
  const saveBtn = document.getElementById("editor-save");
  const cancelBtn = document.getElementById("editor-cancel");
  const copyBtn = document.getElementById("copy-markdown");

  if (editBtn && docView && docEditor && textarea) {
    let previewTimer = null;

    const sidebar = document.getElementById("sidebar");
    const docPage = document.querySelector(".doc-page");
    const previewPane = document.querySelector(".editor-preview");

    /** Find the topmost visible heading in rendered content */
    function getTopmostVisibleHeading() {
      const headings = docView.querySelectorAll("h1, h2, h3, h4, h5, h6");
      const headerOffset = parseInt(getComputedStyle(document.documentElement).getPropertyValue("--sw-header-height")) || 56;
      for (const h of headings) {
        const rect = h.getBoundingClientRect();
        if (rect.top >= headerOffset - 10) {
          return h.textContent?.trim() || null;
        }
      }
      // All headings above viewport — use last one
      if (headings.length) return headings[headings.length - 1].textContent?.trim() || null;
      return null;
    }

    /** Find the line number of a heading in the textarea */
    function findHeadingLine(headingText) {
      const lines = textarea.value.split("\n");
      for (let i = 0; i < lines.length; i++) {
        const match = lines[i].match(/^#{1,6}\s+(.+)/);
        if (match && match[1].trim() === headingText) return i;
      }
      return -1;
    }

    /** Scroll textarea to a line number */
    function scrollTextareaToLine(lineNum) {
      const lineHeight = parseFloat(getComputedStyle(textarea).lineHeight) || 24;
      textarea.scrollTop = lineNum * lineHeight;
    }

    /** Get the heading nearest the cursor position in the textarea */
    function getHeadingNearCursor() {
      const pos = textarea.selectionStart;
      const textBefore = textarea.value.slice(0, pos);
      const lines = textBefore.split("\n");
      for (let i = lines.length - 1; i >= 0; i--) {
        const match = lines[i].match(/^#{1,6}\s+(.+)/);
        if (match) return match[1].trim();
      }
      return null;
    }

    /** Scroll preview pane to a heading by text */
    function scrollPreviewToHeading(headingText) {
      if (!previewPane) return;
      const headings = previewPane.querySelectorAll("h1, h2, h3, h4, h5, h6");
      for (const h of headings) {
        if (h.textContent?.trim() === headingText) {
          h.scrollIntoView({ block: "start", behavior: "auto" });
          return;
        }
      }
    }

    /** Scroll rendered view to a heading by text */
    function scrollViewToHeading(headingText) {
      const headings = docView.querySelectorAll("h1, h2, h3, h4, h5, h6");
      for (const h of headings) {
        if (h.textContent?.trim() === headingText) {
          h.scrollIntoView({ block: "start", behavior: "auto" });
          return;
        }
      }
    }

    editBtn.addEventListener("click", () => {
      // Find which heading is visible before switching
      const visibleHeading = getTopmostVisibleHeading();

      textarea.value = rawContent;
      docView.style.display = "none";
      docEditor.style.display = "flex";
      editBtn.style.display = "none";
      if (sidebar) sidebar.style.display = "none";
      if (docPage) docPage.style.maxWidth = "none";
      document.body.style.overflow = "hidden";
      // Scroll page to top so editor starts at top
      window.scrollTo(0, 0);

      // Scroll textarea and place cursor at the visible heading
      requestAnimationFrame(() => {
        if (visibleHeading) {
          const line = findHeadingLine(visibleHeading);
          if (line >= 0) {
            scrollTextareaToLine(line);
            // Place cursor at start of that line
            const lines = textarea.value.split("\n");
            const pos = lines.slice(0, line).reduce((sum, l) => sum + l.length + 1, 0);
            textarea.setSelectionRange(pos, pos);
          }
        } else {
          // No heading found — cursor at top
          textarea.setSelectionRange(0, 0);
          textarea.scrollTop = 0;
        }
        textarea.focus();
      });

      updatePreview().then(() => {
        if (visibleHeading) {
          requestAnimationFrame(() => scrollPreviewToHeading(visibleHeading));
        }
      });
    });

    cancelBtn?.addEventListener("click", () => {
      const headingNearCursor = getHeadingNearCursor();

      docEditor.style.display = "none";
      docView.style.display = "block";
      editBtn.style.display = "";
      if (sidebar) sidebar.style.display = "";
      if (docPage) docPage.style.maxWidth = "";
      document.body.style.overflow = "";

      // Scroll view to the heading nearest the cursor
      requestAnimationFrame(() => {
        if (headingNearCursor) scrollViewToHeading(headingNearCursor);
      });
    });

    // Sync preview scroll to cursor position on input/click
    let syncTimer = null;
    function syncPreviewToCursor() {
      clearTimeout(syncTimer);
      syncTimer = setTimeout(() => {
        const heading = getHeadingNearCursor();
        if (heading) scrollPreviewToHeading(heading);
      }, 150);
    }

    textarea.addEventListener("click", syncPreviewToCursor);
    textarea.addEventListener("keyup", (e) => {
      // Only sync on cursor-moving keys, not every keystroke
      if (["ArrowUp", "ArrowDown", "PageUp", "PageDown", "Home", "End"].includes(e.key)) {
        syncPreviewToCursor();
      }
    });

    // Live preview (debounced) + sync preview scroll after render
    textarea.addEventListener("input", () => {
      clearTimeout(previewTimer);
      previewTimer = setTimeout(async () => {
        await updatePreview();
        syncPreviewToCursor();
      }, 300);
    });

    async function updatePreview() {
      try {
        const res = await fetch(`${API_URL}/api/documents/${spaceSlug}/${slug}/render?preview=true`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ content: textarea.value }),
        });
        // Fallback: if no preview endpoint, render client-side as plain text
        if (!res.ok) {
          preview.innerHTML = `<pre style="white-space: pre-wrap;">${textarea.value.replace(/</g, "&lt;")}</pre>`;
          return;
        }
        const data = await res.json();
        preview.innerHTML = data.html || "";
      } catch {
        preview.innerHTML = `<pre style="white-space: pre-wrap;">${textarea.value.replace(/</g, "&lt;")}</pre>`;
      }
    }

    saveBtn?.addEventListener("click", async () => {
      saveBtn.disabled = true;
      saveBtn.textContent = "Saving...";
      try {
        const res = await fetch(`${API_URL}/api/documents/${spaceSlug}/${slug}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ content: textarea.value }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert("Failed to save. You may need to sign in.");
          saveBtn.disabled = false;
          saveBtn.textContent = "Save";
        }
      } catch {
        alert("Connection error.");
        saveBtn.disabled = false;
        saveBtn.textContent = "Save";
      }
    });
  }

  // Copy markdown
  copyBtn?.addEventListener("click", () => {
    navigator.clipboard.writeText(rawContent).then(() => {
      const span = copyBtn.querySelector("span");
      if (span) {
        span.textContent = "Copied!";
        setTimeout(() => { span.textContent = "Copy markdown"; }, 2000);
      }
    });
  });

  // Actions menu
  const actionsToggle = document.getElementById("actions-toggle");
  const actionsDropdown = document.getElementById("actions-dropdown");

  actionsToggle?.addEventListener("click", (e) => {
    e.stopPropagation();
    const visible = actionsDropdown.style.display !== "none";
    actionsDropdown.style.display = visible ? "none" : "block";
  });

  document.addEventListener("click", () => {
    if (actionsDropdown) actionsDropdown.style.display = "none";
  });

  // Rename
  document.getElementById("action-rename")?.addEventListener("click", async () => {
    const newTitle = prompt("New title:", document.querySelector("h1")?.textContent || "");
    if (!newTitle) return;
    const newSlug = newTitle.toLowerCase().replace(/[^a-z0-9-]/g, "-").replace(/-+/g, "-").replace(/^-|-$/g, "");

    const res = await fetch(`/s/${spaceSlug}/${slug}/rename`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ title: newTitle, slug: newSlug }),
    });

    if (res.ok) {
      const doc = await res.json();
      window.location.href = `/s/${spaceSlug}/${doc.slug}`;
    } else if (res.status === 409) {
      alert("A document with that name already exists.");
    } else {
      alert("Rename failed.");
    }
  });

  // Duplicate
  document.getElementById("action-duplicate")?.addEventListener("click", async () => {
    const res = await fetch(`/s/${spaceSlug}/${slug}/duplicate`, {
      method: "POST",
    });

    if (res.ok) {
      const doc = await res.json();
      window.location.href = `/s/${spaceSlug}/${doc.slug}`;
    } else {
      alert("Duplicate failed.");
    }
  });

  // Download PDF
  document.getElementById("action-pdf")?.addEventListener("click", () => {
    const a = document.createElement("a");
    a.href = `/s/${spaceSlug}/${slug}/pdf`;
    a.download = `${slug}.pdf`;
    a.click();
  });

  // Delete
  document.getElementById("action-delete")?.addEventListener("click", async () => {
    if (!confirm("Delete this document? This cannot be undone.")) return;

    const res = await fetch(`/s/${spaceSlug}/${slug}/delete`, {
      method: "DELETE",
    });

    if (res.ok) {
      window.location.href = `/s/${spaceSlug}`;
    } else {
      alert("Delete failed.");
    }
  });
</script>
)}
