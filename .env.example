# ── Public-facing URLs (what the browser sees) ──────────────────────
# Local dev: separate ports for API and web.
# Production: typically the same origin behind nginx/Caddy.
PUBLIC_URL=http://localhost:4000
PUBLIC_API_URL=http://localhost:4100

# ── Internal service URLs (server-to-server) ────────────────────────
DATABASE_URL=postgres://sideways:sideways@localhost:5432/sideways
SEAWEEDFS_FILER_URL=http://localhost:8888
KRATOS_PUBLIC_URL=http://localhost:4433
KRATOS_ADMIN_URL=http://localhost:4434
HYDRA_PUBLIC_URL=http://localhost:4444
HYDRA_ADMIN_URL=http://localhost:4445
WEASYPRINT_URL=http://localhost:5001
# Optional — the server defaults to this if unset, so existing hosts need no edit.
MERMAID_URL=http://localhost:5002

# ── Hydra issuer (must match JWT "iss" claim) ───────────────────────
HYDRA_ISSUER_URL=http://localhost:4100

# Required audience claim on JWT access tokens. Must match the audience
# configured on the Hydra OAuth clients (see infra/scripts/init-hydra-client.sh).
API_AUDIENCE=sideways-api

# ── Secrets ─────────────────────────────────────────────────────────
# REPLACE every value below before running anything that's not on your
# local machine. The placeholders are intentionally invalid for Kratos
# (cipher secret must be exactly 32 ASCII chars) so a copy-paste deploy
# fails fast rather than booting with a public-known secret.
#
# Generate strong random values with:  ./scripts/gen-secrets.sh
POSTGRES_PASSWORD=REPLACE_ME
HYDRA_SYSTEM_SECRET=REPLACE_ME_with_a_long_random_string
KRATOS_COOKIE_SECRET=REPLACE_ME_with_a_long_random_string
# Kratos cipher secret MUST be exactly 32 ASCII characters.
KRATOS_CIPHER_SECRET=REPLACE_ME_with_exactly_32_chars
# Shared secret between Kratos and the API for the registration webhook.
# Without this, anyone reachable to the API can POST users into the DB.
KRATOS_WEBHOOK_SECRET=REPLACE_ME_with_a_long_random_string

# ── SMTP (for password recovery emails) ─────────────────────────────
SMTP_URL=smtp://localhost:1025/?disable_starttls=true
SMTP_FROM=noreply@example.com

# ── CORS ────────────────────────────────────────────────────────────
# Extra origins allowed to make credentialed requests, comma-separated.
# PUBLIC_URL/PUBLIC_API_URL above are always allowed; this is for any
# additional production hosts (CDN, alternate domain, etc).
# CORS_ORIGINS=https://docs.example.com,https://staging.example.com

# ── Docker Compose (infra/) ─────────────────────────────────────────
API_INTERNAL_URL=http://host.docker.internal:4100
