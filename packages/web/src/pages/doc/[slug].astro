---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/document.css";

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:4100";
const { slug } = Astro.params;

let doc: { title: string; html: string; tags: string[] } | null = null;

try {
  const res = await fetch(`${API_URL}/api/documents/${slug}/render`);
  if (res.ok) {
    doc = await res.json();
  }
} catch {
  // API not available
}

const html = doc?.html ?? "";
---

<BaseLayout title={doc?.title ?? "Not Found"}>
  {doc ? (
    <article class="sw-document">
      <nav class="sw-breadcrumb">
        <a href="/">Documents</a> / <span>{doc.title}</span>
      </nav>
      <div set:html={html} />
    </article>
  ) : (
    <div class="sw-not-found">
      <h1>Document not found</h1>
      <a href="/">Back to documents</a>
    </div>
  )}
</BaseLayout>

<style>
  .sw-breadcrumb {
    font-size: 0.85rem;
    color: #64748b;
    margin-bottom: 2rem;
  }

  .sw-breadcrumb a {
    color: #6366f1;
    text-decoration: none;
  }

  .sw-breadcrumb a:hover {
    text-decoration: underline;
  }

  .sw-not-found {
    max-width: 72ch;
    margin: 0 auto;
    padding: 4rem 2rem;
    text-align: center;
  }

  .sw-not-found h1 {
    margin-bottom: 1rem;
  }

  .sw-not-found a {
    color: #6366f1;
  }
</style>
