---
/**
 * OAuth2 callback — exchanges code for tokens, then fetches user info
 * from our own API using the access token.
 */
const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:4100";

const code = Astro.url.searchParams.get("code");
const state = Astro.url.searchParams.get("state") || "";
const error = Astro.url.searchParams.get("error");

// Extract returnTo from state (format: "random:base64url(returnTo)")
let returnTo = "/";
try {
  const colonIdx = state.indexOf(":");
  if (colonIdx > 0) {
    returnTo = Buffer.from(state.slice(colonIdx + 1), "base64url").toString() || "/";
  }
} catch {}
// Sanitize: only allow relative paths
if (!returnTo.startsWith("/")) returnTo = "/";

if (error) {
  const errorDesc = Astro.url.searchParams.get("error_description") || "";
  return Astro.redirect(`/auth/login?error=${encodeURIComponent(error)}&desc=${encodeURIComponent(errorDesc)}`);
}

if (!code) {
  return Astro.redirect("/auth/login?error=missing_code");
}

// Exchange code for tokens
const redirectUri = `${Astro.url.origin}/auth/callback`;
const tokenRes = await fetch(`${API_URL}/api/auth/token`, {
  method: "POST",
  headers: { "Content-Type": "application/x-www-form-urlencoded" },
  body: new URLSearchParams({
    grant_type: "authorization_code",
    code,
    redirect_uri: redirectUri,
    client_id: "sideways-web",
  }),
});

if (!tokenRes.ok) {
  return Astro.redirect("/auth/login?error=token_exchange_failed");
}

const tokens = await tokenRes.json();

if (!tokens.access_token) {
  return Astro.redirect("/auth/login?error=no_access_token");
}

// Fetch user info from our API using the access token
let userName = "Unknown";
let userEmail = "unknown";

try {
  const meRes = await fetch(`${API_URL}/api/auth/me`, {
    headers: { Authorization: `Bearer ${tokens.access_token}` },
  });
  if (meRes.ok) {
    const me = await meRes.json();
    userName = me.name;
    userEmail = me.email;
  }
} catch {}

// Store in session
await Astro.session?.set("access_token", tokens.access_token);
await Astro.session?.set("refresh_token", tokens.refresh_token);
await Astro.session?.set("user_email", userEmail);
await Astro.session?.set("user_name", userName);

return Astro.redirect(returnTo);
---
