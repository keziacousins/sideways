{
  "name": "sideways",
  "version": "1.4.6",
  "private": true,
  "type": "module",
  "description": "Neither markup nor markdown, but something else entirely.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "typecheck": "pnpm -r exec tsc --noEmit"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "axios": "^1.15.1",
      "defu": "^6.1.5",
      "devalue": "^5.8.1",
      "fast-uri": "^3.1.2",
      "follow-redirects": "^1.16.0",
      "ip-address": "^10.1.1",
      "path-to-regexp": "^8.4.0",
      "postcss": "^8.5.10",
      "esbuild": "^0.27.4",
      "@hono/node-server": "^1.19.13"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.6.0",
    "postgres": "^3.4.8",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@fontsource-variable/fira-code": "^5.2.7"
  }
}
