---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";

import { apiFetch } from "../../lib/api.ts";
import { buildNavTree } from "../../lib/nav.ts";
import { themeToCSS } from "../../lib/theme.ts";
import { icons } from "../../lib/icons.ts";

const { space: spaceSlug } = Astro.params;
const { accessToken } = Astro.locals;

let space: { name: string; slug: string; description: string | null; visibility: string; canWrite?: boolean; theme?: { tokens: any } } | null = null;
let documents: { id: string; slug: string; title: string; tags: string[]; sectionId: string | null; parentId: string | null; position?: number; unread?: boolean; updatedAt?: string }[] = [];
let sections: { id: string; slug: string; title: string; parentId: string | null; position: number }[] = [];

try {
  const spaceRes = await apiFetch(`/api/spaces/${spaceSlug}`, accessToken);
  if (spaceRes.ok) {
    space = await spaceRes.json();
    const [docsRes, sectionsRes] = await Promise.all([
      apiFetch(`/api/documents?space=${spaceSlug}`, accessToken),
      apiFetch(`/api/spaces/${spaceSlug}/sections`, accessToken),
    ]);
    if (docsRes.ok) documents = await docsRes.json();
    if (sectionsRes.ok) sections = await sectionsRes.json();
  }
} catch {
  // API not available
}

const navItems = buildNavTree(sections, documents);
const themeCss = themeToCSS(space?.theme?.tokens);
---

<BaseLayout title={space?.name ?? "Not Found"} sidebar={!!space}>
  <Fragment slot="sidebar">
    {space && (
      <Sidebar
        spaceSlug={spaceSlug!}
        spaceName={space.name}
        items={navItems}
      />
    )}
  </Fragment>

  {themeCss && <Fragment set:html={`<style>${themeCss}</style>`} />}

  {space ? (
    <div class="space-landing">
      <div class="space-header animate-in">
        <div class="space-header-top">
          <h1>{space.name}</h1>
          <div class="space-header-actions">
            {space?.canWrite && (
              <button class="new-doc-btn" id="new-doc-btn">
                <Fragment set:html={icons.plus(14)} />
                New document
              </button>
            )}
            {space?.canWrite && (
              <a href={`/s/${spaceSlug}/settings`} class="space-settings-link">Settings</a>
            )}
          </div>
        </div>
        {space.description && <p class="space-desc">{space.description}</p>}
      </div>

      {documents.length > 0 && (
        <div class="sort-bar">
          <div class="sort-buttons">
            <button class="sort-btn active" data-sort="title">Title</button>
            <button class="sort-btn" data-sort="updated">Updated</button>
            <button class="sort-btn" data-sort="unread">Unread</button>
          </div>
          <button class="sort-dir" id="sort-dir" title="Toggle sort direction">↓</button>
          {accessToken && <button class="mark-all-read-btn" id="mark-all-read">Mark all read</button>}
        </div>
      )}

      <div class="doc-grid" id="doc-grid">
        {documents.length === 0 ? (
          <p class="empty-state">
            {!accessToken && space.visibility !== "public"
              ? <><a href={`/auth/login?returnTo=/s/${spaceSlug}`}>Sign in</a> to view this space.</>
              : "No documents in this space yet."
            }
          </p>
        ) : (
          documents.map((doc, i) => (
            <div
              class:list={["doc-card-row", "animate-in", { unread: doc.unread }]}
              style={`animation-delay: ${(i + 1) * 60}ms`}
              data-updated={doc.updatedAt || ""}
              data-slug={doc.slug}
            >
              <a
                href={`/s/${spaceSlug}/${doc.slug}`}
                class="doc-card"
              >
                <div class="doc-card-icon"><Fragment set:html={icons.document(16)} /></div>
                <span class="doc-card-title">{doc.title}{doc.unread && <span class="unread-indicator">●</span>}</span>
                {doc.updatedAt && (
                  <span class="doc-card-date">{new Date(doc.updatedAt).toLocaleDateString(undefined, { month: "short", day: "numeric", year: "numeric" })}</span>
                )}
                {doc.tags?.length > 0 && (
                  <div class="doc-tags">
                    {doc.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}
              </a>
              {space?.canWrite && (
                <button class="doc-rename-btn" title="Rename" data-slug={doc.slug} data-title={doc.title}>
                  <Fragment set:html={icons.pencil(13)} />
                </button>
              )}
            </div>
          ))
        )}
      </div>
    </div>
  ) : (
    <div class="not-found">
      <h1>Space not found</h1>
      <a href="/">Back to spaces</a>
    </div>
  )}
</BaseLayout>

<style>
  .space-landing {
    max-width: 640px;
  }

  .space-header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .space-header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .new-doc-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    background: none;
    border: 1px solid var(--sw-border);
    border-radius: var(--sw-radius-sm);
    color: var(--sw-text-secondary);
    font-size: var(--sw-text-sm);
    cursor: pointer;
    transition: all var(--sw-duration-fast) var(--sw-ease);
  }
  .new-doc-btn:hover {
    border-color: var(--sw-accent);
    color: var(--sw-accent);
  }
  .new-doc-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .space-settings-link {
    font-size: var(--sw-text-sm);
    color: var(--sw-text-tertiary);
    text-decoration: none;
  }

  .space-settings-link:hover {
    color: var(--sw-text-primary);
  }

  .space-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--sw-border);
    margin-bottom: 2rem;
  }

  .space-header h1 {
    font-family: var(--sw-font-display);
    font-size: var(--sw-text-3xl);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
  }

  .space-desc {
    color: var(--sw-text-tertiary);
    font-size: var(--sw-text-base);
  }

  .doc-grid {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .doc-card-row {
    display: flex;
    align-items: center;
    border-radius: var(--sw-radius-md);
    transition: background var(--sw-duration-fast) var(--sw-ease);
  }

  .doc-card-row:hover {
    background: var(--sw-ink-light);
  }

  .doc-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    text-decoration: none;
    color: inherit;
    flex: 1;
    min-width: 0;
  }

  .doc-rename-btn {
    background: none;
    border: none;
    color: var(--sw-text-ghost);
    padding: 0.4rem;
    margin-right: 0.5rem;
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--sw-duration-fast) var(--sw-ease), color var(--sw-duration-fast) var(--sw-ease);
    flex-shrink: 0;
  }
  .doc-card-row:hover .doc-rename-btn { opacity: 1; }
  .doc-rename-btn:hover { color: var(--sw-accent); }

  .doc-card-icon {
    color: var(--sw-text-tertiary);
    flex-shrink: 0;
  }

  .doc-card-title {
    font-size: var(--sw-text-base);
    color: var(--sw-text-primary);
    flex: 1;
  }

  .doc-card-date {
    font-size: var(--sw-text-xs);
    color: var(--sw-text-secondary);
    flex-shrink: 0;
  }

  .unread-indicator {
    color: var(--sw-accent);
    font-size: 6px;
    margin-left: 0.35rem;
    vertical-align: middle;
  }

  .doc-tags {
    display: flex;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  .tag {
    font-size: var(--sw-text-xs);
    padding: 0.15em 0.5em;
    background: var(--sw-ink-lighter);
    border-radius: var(--sw-radius-sm);
    color: var(--sw-text-tertiary);
  }

  .empty-state {
    padding: 3rem 0;
    text-align: center;
    color: var(--sw-text-ghost);
  }

  .not-found {
    padding: 4rem 0;
    text-align: center;
  }

  .not-found h1 {
    font-family: var(--sw-font-display);
    margin-bottom: 1rem;
  }

  .sort-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .sort-buttons {
    display: flex;
    gap: 2px;
    background: var(--sw-ink-surface);
    border-radius: var(--sw-radius-sm);
    padding: 2px;
  }

  .sort-btn {
    padding: 0.2rem 0.6rem;
    background: none;
    border: none;
    border-radius: var(--sw-radius-sm);
    color: var(--sw-text-tertiary);
    font-size: var(--sw-text-xs);
    cursor: pointer;
    transition: all var(--sw-duration-fast) var(--sw-ease);
  }

  .sort-btn:hover { color: var(--sw-text-primary); }
  .sort-btn.active {
    background: var(--sw-ink-lighter);
    color: var(--sw-text-primary);
  }

  .sort-dir {
    background: none;
    border: none;
    color: var(--sw-text-tertiary);
    font-size: var(--sw-text-sm);
    cursor: pointer;
    padding: 0.15rem 0.3rem;
    line-height: 1;
  }
  .sort-dir:hover { color: var(--sw-text-primary); }

  .mark-all-read-btn {
    margin-left: auto;
    background: none;
    border: none;
    color: var(--sw-text-ghost);
    font-size: var(--sw-text-xs);
    cursor: pointer;
    padding: 0;
  }
  .mark-all-read-btn:hover { color: var(--sw-accent); }

  @media (max-width: 600px) {
    .doc-card {
      flex-wrap: wrap;
      padding: 0.6rem 0.75rem;
      gap: 0.4rem;
    }
    .doc-card-icon { display: none; }
    .doc-tags {
      width: 100%;
      flex-wrap: wrap;
    }
  }
</style>

<script>
  const grid = document.getElementById("doc-grid");
  const dirBtn = document.getElementById("sort-dir");
  const sortBtns = document.querySelectorAll(".sort-btn");
  const markAllBtn = document.getElementById("mark-all-read");

  let currentSort = "title";
  let ascending = true;

  function doSort() {
    if (!grid) return;
    const cards = Array.from(grid.querySelectorAll(".doc-card-row")) as HTMLElement[];
    cards.sort((a, b) => {
      let cmp = 0;
      switch (currentSort) {
        case "updated":
          cmp = new Date(a.dataset.updated || 0).getTime() - new Date(b.dataset.updated || 0).getTime();
          break;
        case "unread":
          cmp = (a.classList.contains("unread") ? 0 : 1) - (b.classList.contains("unread") ? 0 : 1);
          break;
        default:
          cmp = (a.querySelector(".doc-card-title")?.textContent || "").localeCompare(
            b.querySelector(".doc-card-title")?.textContent || ""
          );
      }
      return ascending ? cmp : -cmp;
    });
    for (const card of cards) grid.appendChild(card);
  }

  sortBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      const sort = (btn as HTMLElement).dataset.sort || "title";
      if (sort === currentSort) {
        ascending = !ascending;
      } else {
        currentSort = sort;
        ascending = sort === "title"; // title asc, others desc by default
      }
      sortBtns.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      if (dirBtn) dirBtn.textContent = ascending ? "↓" : "↑";
      doSort();
    });
  });

  dirBtn?.addEventListener("click", () => {
    ascending = !ascending;
    dirBtn.textContent = ascending ? "↓" : "↑";
    doSort();
  });

  markAllBtn?.addEventListener("click", async () => {
    const spaceSlug = window.location.pathname.split("/")[2];
    const res = await fetch(`/s/${spaceSlug}/mark-read`, { method: "POST" });
    if (res.ok) {
      // Remove all unread indicators
      document.querySelectorAll(".doc-card-row.unread").forEach(el => el.classList.remove("unread"));
      document.querySelectorAll(".unread-indicator").forEach(el => el.remove());
      markAllBtn.style.display = "none";
    }
  });

  // New document
  const newDocBtn = document.getElementById("new-doc-btn");
  newDocBtn?.addEventListener("click", async () => {
    const spaceSlug = window.location.pathname.split("/")[2];
    newDocBtn.setAttribute("disabled", "");
    newDocBtn.textContent = "Creating...";
    const res = await fetch(`/s/${spaceSlug}/new-doc`, { method: "POST" });
    if (res.ok) {
      const { slug } = await res.json();
      window.location.href = `/s/${spaceSlug}/${slug}?edit=1`;
    } else {
      alert("Failed to create document.");
      newDocBtn.removeAttribute("disabled");
      newDocBtn.textContent = "New document";
    }
  });

  // Rename from listing
  document.querySelectorAll(".doc-rename-btn").forEach(btn => {
    btn.addEventListener("click", async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const el = btn as HTMLElement;
      const docSlug = el.dataset.slug;
      const currentTitle = el.dataset.title;
      const newTitle = prompt("Rename document:", currentTitle);
      if (!newTitle || newTitle === currentTitle) return;

      const newSlug = newTitle.toLowerCase().replace(/[^a-z0-9-]/g, "-").replace(/-+/g, "-").replace(/^-|-$/g, "");
      const spaceSlug = window.location.pathname.split("/")[2];
      const res = await fetch(`/s/${spaceSlug}/${docSlug}/rename`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ title: newTitle, slug: newSlug }),
      });

      if (res.ok) {
        window.location.reload();
      } else if (res.status === 409) {
        alert("A document with that name already exists.");
      } else {
        alert("Rename failed.");
      }
    });
  });
</script>
