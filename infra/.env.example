# Docker Compose environment for infra services.
# Copy to .env next to compose.yml and adjust for your environment.

# Public-facing URLs (what the browser sees)
PUBLIC_URL=http://localhost:4000
PUBLIC_API_URL=http://localhost:4100

# Hydra issuer must match what the API server validates JWTs against
HYDRA_ISSUER_URL=http://localhost:4100

# How containers reach the API server (runs on the host, not in Docker)
API_INTERNAL_URL=http://host.docker.internal:4100

# Secrets — placeholders are intentionally invalid so a copy-paste deploy
# fails fast. Generate strong random values with: ../scripts/gen-secrets.sh
POSTGRES_USER=sideways
POSTGRES_PASSWORD=REPLACE_ME
HYDRA_SYSTEM_SECRET=REPLACE_ME_with_a_long_random_string
KRATOS_COOKIE_SECRET=REPLACE_ME_with_a_long_random_string
# Kratos cipher secret MUST be exactly 32 ASCII characters.
KRATOS_CIPHER_SECRET=REPLACE_ME_with_exactly_32_chars
# Shared secret between Kratos and the API for the registration webhook.
KRATOS_WEBHOOK_SECRET=REPLACE_ME_with_a_long_random_string

# SMTP
SMTP_URL=smtp://mailhog:1025/?disable_starttls=true
SMTP_FROM=noreply@example.com
