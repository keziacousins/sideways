{
  "name": "sideways",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "Neither markup nor markdown, but something else entirely.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "typecheck": "pnpm -r exec tsc --noEmit"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.6.0",
    "postgres": "^3.4.8",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@fontsource-variable/fira-code": "^5.2.7"
  }
}
